@* Tải ảnh/chứng từ lên ngay khi chọn; danh sách file chờ gắn vào phiếu khi lưu. *@
@inject AttachmentService Attachments
@inject ToastService Toast
@inject DocumentScanService Scanner

<div class="nh-upload @Class">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label mb-1">@Label @if (Required) {<span class="text-danger">*</span>}</label>
    }
    <div class="d-flex flex-wrap gap-2 align-items-start">
        @foreach (var f in HideThumbs ? [] : Files)
        {
            <div class="nh-thumb" @key="f.Path">
                @if (f.IsImage)
                {
                    <a href="@f.Path" target="_blank"><img src="@f.Path" alt="@f.FileName" /></a>
                }
                else
                {
                    <a href="@f.Path" target="_blank" class="nh-thumb-file"><i class="fas fa-file-pdf"></i><span>@f.FileName</span></a>
                }
                <button type="button" class="nh-thumb-remove" title="Bỏ file" @onclick="() => Remove(f)">×</button>
            </div>
        }
        <label class="nh-upload-btn @(uploading ? "disabled" : "")">
            <i class="fas @(uploading || scanning ? "fa-spinner fa-spin" : (Camera ? "fa-camera" : "fa-paperclip"))"></i>
            <span>@(scanning ? "Đang quét chứng từ..." : uploading ? "Đang tải..." : ButtonText)</span>
            <InputFile class="d-none" accept="@Accept" multiple="@Multiple" capture="@(Camera ? CameraFacing : null)" OnChange="OnSelected" disabled="@uploading" />
        </label>
        @if (Camera && !string.IsNullOrEmpty(PickButtonText))
        {
            @* Nút thứ hai không ép mở máy ảnh: chọn ảnh có sẵn trong máy / thư viện *@
            <label class="nh-upload-btn alt @(uploading ? "disabled" : "")">
                <i class="fas @PickIcon"></i>
                @if (!string.IsNullOrWhiteSpace(PickButtonText)) { <span>@PickButtonText</span> }
                <InputFile class="d-none" accept="@Accept" multiple="@Multiple" OnChange="OnSelected" disabled="@uploading" />
            </label>
        }
    </div>
</div>

@code {
    [Parameter] public List<PendingFile> Files { get; set; } = [];
    [Parameter] public EventCallback<List<PendingFile>> FilesChanged { get; set; }
    [Parameter] public string Kind { get; set; } = "Files";
    [Parameter] public string? Label { get; set; }
    [Parameter] public string ButtonText { get; set; } = "Chọn ảnh/chứng từ";
    [Parameter] public string Accept { get; set; } = "image/*,.pdf";
    [Parameter] public bool Multiple { get; set; } = true;
    /// <summary>Nút chính mở thẳng máy ảnh (capture).</summary>
    [Parameter] public bool Camera { get; set; }
    /// <summary>"environment" = camera sau (giấy tờ), "user" = camera trước (chân dung).</summary>
    [Parameter] public string CameraFacing { get; set; } = "environment";
    /// <summary>Có đặt (và Camera=true) thì thêm nút chọn ảnh có sẵn, không ép mở máy ảnh.</summary>
    [Parameter] public string? PickButtonText { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string PickIcon { get; set; } = "fa-images";
    /// <summary>Không vẽ ảnh thu nhỏ (trang tự vẽ danh sách file chờ).</summary>
    [Parameter] public bool HideThumbs { get; set; }
    /// <summary>Đuôi file được phép (mặc định ảnh + PDF).</summary>
    [Parameter] public string[]? AllowedExtensions { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool IsPublic { get; set; }
    [Parameter] public EventCallback<PendingFile> Uploaded { get; set; }
    [Parameter] public EventCallback<PendingFile> Removed { get; set; }
    /// <summary>Gọi một lần sau khi tải xong cả lượt file đã chọn.</summary>
    [Parameter] public EventCallback<List<PendingFile>> BatchUploaded { get; set; }
    /// <summary>Có đặt thì tự quét chứng từ vừa tải (Gemini/Claude) và trả kết quả để điền số tiền, ngày, nội dung.</summary>
    [Parameter] public EventCallback<ReceiptScanResult> Scanned { get; set; }

    private bool scanning;

    private bool uploading;

    private async Task OnSelected(InputFileChangeEventArgs e)
    {
        uploading = true;
        var batch = new List<PendingFile>();
        try
        {
            foreach (var file in e.GetMultipleFiles(20))
            {
                if (file.Size > FileStorage.MaxFileSize)
                {
                    Toast.Error($"{file.Name} vượt quá 15MB.");
                    continue;
                }
                try
                {
                    // Ảnh chụp điện thoại thường 3-8MB: thu nhỏ ngay trên trình duyệt (tối đa 1600px, JPEG) trước khi tải lên
                    // để tải nhanh và quét AI nhanh. Trình duyệt không đọc được định dạng (HEIC cũ...) thì giữ nguyên file gốc.
                    var upload = file;
                    var name = file.Name;
                    if (file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) && file.Size > 300 * 1024)
                    {
                        try
                        {
                            upload = await file.RequestImageFileAsync("image/jpeg", 1600, 1600);
                            name = Path.ChangeExtension(file.Name, ".jpg");
                        }
                        catch (Exception) { upload = file; name = file.Name; }
                    }
                    await using var stream = upload.OpenReadStream(FileStorage.MaxFileSize);
                    using var buffer = new MemoryStream();
                    await stream.CopyToAsync(buffer);
                    buffer.Position = 0;
                    var saved = await Attachments.UploadAsync(buffer, name, Kind, IsPublic, AllowedExtensions);
                    if (!Multiple) Files.Clear();
                    Files.Add(saved);
                    batch.Add(saved);
                    await Uploaded.InvokeAsync(saved);
                }
                catch (InvalidOperationException ex)
                {
                    Toast.Error(ex.Message);
                }
            }
            await FilesChanged.InvokeAsync(Files);
        }
        finally
        {
            uploading = false;
        }
        if (batch.Count > 0) await BatchUploaded.InvokeAsync(batch);
        if (batch.Count > 0 && Scanned.HasDelegate) await ScanAsync(batch[0]);
    }

    private async Task ScanAsync(PendingFile f)
    {
        try
        {
            if (!await Scanner.IsConfiguredAsync()) return;
            scanning = true;
            StateHasChanged();
            var r = await Scanner.ScanReceiptAsync(f.Path);
            if (r.Amount == null && r.Date == null && r.Description == null) { Toast.Warning("Không đọc được số tiền trong chứng từ, hãy nhập tay."); return; }
            await Scanned.InvokeAsync(r);
            Toast.Info("Đã quét chứng từ: " + r.Summary + ". Hãy kiểm tra lại.");
        }
        catch (InvalidOperationException ex) { Toast.Warning(ex.Message); }
        catch (HttpRequestException ex) { Toast.Warning("Không kết nối được dịch vụ quét: " + ex.Message); }
        catch (TaskCanceledException) { Toast.Warning("Quét chứng từ quá lâu, hãy nhập tay."); }
        finally { scanning = false; }
    }

    private async Task Remove(PendingFile f)
    {
        Files.Remove(f);
        Attachments.Discard([f]);
        await Removed.InvokeAsync(f);
        await FilesChanged.InvokeAsync(Files);
    }
}
