@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits NhPage
@inject RoomService Rooms
@inject SetupService Setup

<PageTitle>Trang chính</PageTitle>

<div class="nh-ops mb-3">
    <a class="nh-op in" href="nhan-phong"><i class="fas fa-door-open"></i><span>Nhận phòng</span><small>Khách mới vào ở</small></a>
    <a class="nh-op out" href="tra-phong"><i class="fas fa-sign-out-alt"></i><span>Trả phòng</span><small>Khách chuyển đi</small></a>
    <a class="nh-op bill" href="thu-tien"><i class="fas fa-file-invoice-dollar"></i><span>Thu tiền tháng</span><small>Lập phiếu, thu tiền, in phiếu</small></a>
    <a class="nh-op fix" href="sua-chua"><i class="fas fa-tools"></i><span>Sửa chữa</span><small>Ảnh + chứng từ</small></a>
    <a class="nh-op buy" href="mua-sam"><i class="fas fa-shopping-cart"></i><span>Mua sắm</span><small>Hóa đơn</small></a>
</div>

@if (map != null)
{
    <div class="row g-2 mb-3">
        <div class="col-4"><a class="nh-stat d-block text-decoration-none text-reset" href="so-do"><div class="v text-primary">@map.Occupied<span class="text-muted fs-6">/@map.Total</span></div><div class="l">Phòng có khách</div></a></div>
        <div class="col-4"><a class="nh-stat d-block text-decoration-none text-reset" href="so-do"><div class="v text-secondary">@map.Empty</div><div class="l">Phòng trống</div></a></div>
        <div class="col-4"><a class="nh-stat d-block text-decoration-none text-reset" href="thu-tien"><div class="v text-danger">@Fmt.Money(map.Outstanding / 1000)k</div><div class="l">Còn phải thu</div></a></div>
    </div>
    @if (unpaid.Count > 0)
    {
        <div class="nh-card mb-3">
            <h5><i class="fas fa-exclamation-circle text-danger"></i> Phòng còn nợ (@unpaid.Count)</h5>
            <div class="nh-chips">
                @foreach (var r in unpaid) { <a class="btn btn-sm btn-outline-danger" href="@($"phong/{r.Code}")">@r.Code · @Fmt.Money(r.Outstanding / 1000)k</a> }
            </div>
        </div>
    }
    @if (noBill.Count > 0)
    {
        <div class="nh-card mb-3">
            <h5><i class="fas fa-bolt text-primary"></i> Chưa ghi số điện kỳ @map.BillingMonth.ToString("00")/@map.BillingYear (@noBill.Count)</h5>
            <div class="nh-chips">
                @foreach (var r in noBill) { <a class="btn btn-sm btn-outline-primary" href="so-dien">@r.Code</a> }
            </div>
        </div>
    }
}

<div class="nh-card">
    <h5><i class="fas fa-info-circle"></i> Thông tin</h5>
    <div class="nh-info-grid">
        <a href="chat"><i class="fas fa-comments"></i><span>Chat nội bộ</span></a>
        <a href="so-do"><i class="fas fa-th-large"></i><span>Sơ đồ phòng</span></a>
        <a href="khach-thue"><i class="fas fa-users"></i><span>Khách thuê</span></a>
        <a href="thu-chi"><i class="fas fa-wallet"></i><span>Thu chi</span></a>
        <a href="bao-cao"><i class="fas fa-chart-bar"></i><span>Báo cáo</span></a>
        <a href="quang-cao"><i class="fas fa-bullhorn"></i><span>Quảng cáo</span></a>
        @if (isAdmin) { <a href="cau-hinh"><i class="fas fa-cog"></i><span>Cấu hình</span></a> }
        <a href="huong-dan"><i class="fas fa-question-circle"></i><span>Hướng dẫn</span></a>
        <a href="gioi-thieu" target="_blank"><i class="fas fa-globe-asia"></i><span>Trang khách xem</span></a>
        <a href="app"><i class="fas fa-mobile-alt"></i><span>Cài ứng dụng</span></a>
    </div>
</div>

@code {
    private RoomMap? map;
    private List<RoomCard> unpaid = [], noBill = [];
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        isAdmin = await IsAdminAsync();
        map = await Rooms.GetMapAsync();
        unpaid = map.Rooms.Where(r => r.Outstanding > 0).OrderByDescending(r => r.Outstanding).ToList();
        noBill = map.Rooms.Where(r => r.Color == RoomColor.NoBill).ToList();
    }
}
