@page "/nguoi-dung"
@attribute [Authorize(Roles = Roles.Admin)]
@rendermode InteractiveServer
@inherits NhPage
@inject UserService UserSvc

<PageTitle>Người dùng</PageTitle>

<div class="nh-page-title">
    <h2><i class="fas fa-user-shield"></i> Người dùng</h2>
    <a class="btn btn-outline-secondary" href="cau-hinh"><i class="fas fa-arrow-left"></i> Cấu hình</a>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="nh-card">
            <table class="nh-table">
                <thead><tr><th>Email</th><th>Quyền</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody>
                    @foreach (var u in users)
                    {
                        <tr>
                            <td>@u.Email @if (u.Id == myId) {<span class="badge bg-info">Bạn</span>}</td>
                            <td>@(u.IsAdmin ? "Quản trị" : "Nhân viên")</td>
                            <td>@(u.IsLocked ? "Đã khóa" : "Hoạt động")</td>
                            <td class="text-nowrap">
                                @if (u.Id != myId)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SetAdminAsync(u)">@(u.IsAdmin ? "Bỏ quản trị" : "Cấp quản trị")</button>
                                    <button type="button" class="btn btn-sm btn-outline-warning" @onclick="() => SetLockedAsync(u)">@(u.IsLocked ? "Mở khóa" : "Khóa")</button>
                                }
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => { resetFor = u; resetPwd = null; }">Đặt lại mật khẩu</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (resetFor != null)
            {
                <div class="border rounded p-2 mt-2">
                    <div class="mb-1">Mật khẩu mới cho <strong>@resetFor.Email</strong></div>
                    <div class="input-group" style="max-width: 420px">
                        <input type="newPassword" class="form-control" autocomplete="new-newPassword" @bind="resetPwd" />
                        <button type="button" class="btn btn-primary" @onclick="ResetAsync">Lưu</button>
                        <button type="button" class="btn btn-secondary" @onclick="() => resetFor = null">Hủy</button>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="nh-card">
            <h5>Thêm người dùng</h5>
            <label class="form-label">Email</label><input type="email" class="form-control mb-2" autocomplete="off" @bind="email" />
            <label class="form-label">Mật khẩu</label><input type="newPassword" class="form-control mb-2" autocomplete="new-newPassword" @bind="newPassword" />
            <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="adm" @bind="isAdmin" /><label class="form-check-label" for="adm">Quyền quản trị</label></div>
            <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="CreateAsync"><i class="fas fa-plus"></i> Tạo</button>
            <div class="small text-muted mt-2">Nhân viên: nhận/trả phòng, thu tiền, ghi sửa chữa, mua sắm. Chỉ quản trị được xóa giao dịch, phiếu và sửa cấu hình.</div>
        </div>
    </div>
</div>

@code {
    private List<UserRow> users = [];
    private string? myId, email, newPassword, resetPwd;
    private bool isAdmin;
    private UserRow? resetFor;

    protected override async Task OnInitializedAsync()
    {
        myId = await GetUserIdAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => users = await UserSvc.ListAsync();

    private async Task CreateAsync()
    {
        if (await RunAsync(() => UserSvc.CreateAsync(email ?? "", newPassword ?? "", isAdmin), "Đã tạo người dùng."))
        {
            email = newPassword = null;
            isAdmin = false;
            await LoadAsync();
        }
    }

    private async Task SetAdminAsync(UserRow u)
    {
        if (await RunAsync(() => UserSvc.SetAdminAsync(u.Id, !u.IsAdmin, myId!), "Đã cập nhật.")) await LoadAsync();
    }

    private async Task SetLockedAsync(UserRow u)
    {
        if (await RunAsync(() => UserSvc.SetLockedAsync(u.Id, !u.IsLocked, myId!), "Đã cập nhật.")) await LoadAsync();
    }

    private async Task ResetAsync()
    {
        if (await RunAsync(() => UserSvc.ResetPasswordAsync(resetFor!.Id, resetPwd ?? ""), "Đã đặt lại mật khẩu."))
        {
            resetFor = null;
            resetPwd = null;
        }
    }
}
