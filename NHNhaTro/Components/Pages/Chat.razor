@page "/chat"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits NhPage
@implements IDisposable
@inject ChatService Chats
@inject ChatHub Hub
@inject DocumentScanService Scanner

<PageTitle>Chat nội bộ</PageTitle>

<div class="nh-chat">
    <div class="nh-chat-head">
        <span class="ic"><i class="fas fa-comments"></i></span>
        <div class="min-w-0 flex-grow-1">
            <div class="ttl">Chat nội bộ</div>
            <div class="sub">Mọi người dùng phần mềm đều thấy · <code>@@ai</code> đầu câu để hỏi trợ lý@(aiReady ? "" : " (chưa bật)")</div>
        </div>
        @if (!loadedAll)
        {
            <button type="button" class="btn btn-sm btn-light" @onclick="LoadOlderAsync"><i class="fas fa-history"></i> Tin cũ</button>
        }
    </div>

    <div class="nh-chat-body" id="chatBody">
        @{ DateTime? lastDay = null; string? lastSender = null; }
        @foreach (var m in messages)
        {
            if (lastDay != m.SentAt.Date)
            {
                lastDay = m.SentAt.Date;
                lastSender = null;
                <div class="nh-chat-day">@(m.SentAt.Date == DateTime.Today ? "Hôm nay" : m.SentAt.Date == DateTime.Today.AddDays(-1) ? "Hôm qua" : Fmt.Date(m.SentAt))</div>
            }
            bool mine = m.Sender == me;
            bool showWho = !mine && lastSender != m.Sender;
            lastSender = m.Sender;
            var pics = m.Attachments.Where(x => x.IsImage).ToList();
            var docs = m.Attachments.Where(x => !x.IsImage).ToList();
            bool onlyPics = pics.Count > 0 && docs.Count == 0 && (string.IsNullOrEmpty(m.Text) || m.Text == "(ảnh)");
            <div class="nh-msg @(mine ? "mine" : "") @(m.IsAssistant ? "ai" : "")" @key="m.Id">
                @if (showWho) { <div class="who"><i class="fas @(m.IsAssistant ? "fa-robot" : "fa-user-circle")"></i> @m.DisplayName</div> }
                <div class="bubble @(onlyPics ? "pics-only" : "")">
                    @if (m.RoomCode != null) { <a class="room" href="@($"phong/{m.RoomCode}")"><i class="fas fa-door-closed"></i> @m.RoomCode</a> }
                    @if (pics.Count > 0)
                    {
                        <div class="pics n@(Math.Min(pics.Count, 3))">
                            @foreach (var a in pics) { <a href="@a.Path" target="_blank"><img src="@a.Path" alt="" loading="lazy" /></a> }
                        </div>
                    }
                    @foreach (var a in docs)
                    {
                        <a class="doc" href="@a.Path" download="@a.FileName"><i class="fas @DocIcon(a.FileName)"></i><span>@a.FileName</span><i class="fas fa-download dl"></i></a>
                    }
                    @if (!onlyPics && !string.IsNullOrEmpty(m.Text) && m.Text != "(ảnh)") { <span class="text">@m.Text</span> }
                    <div class="time">@m.SentAt.ToString("HH:mm")
                        @if (isAdmin || mine) { <button type="button" class="del" title="Xóa" @onclick="() => DeleteAsync(m)"><i class="fas fa-trash-alt"></i></button> }
                    </div>
                </div>
            </div>
        }
        @if (messages.Count == 0) { <div class="nh-empty-hint"><i class="fas fa-comments"></i>Chưa có tin nhắn. Hãy chào mọi người!</div> }
        @if (aiThinking) { <div class="nh-msg ai"><div class="who"><i class="fas fa-robot"></i> Trợ lý AI</div><div class="bubble"><i class="fas fa-ellipsis-h fa-fade"></i> đang trả lời...</div></div> }
    </div>

    <div class="nh-chat-input">
        @if (files.Count > 0)
        {
            <div class="pending">
                @foreach (var f in files)
                {
                    <div class="pf" @key="f.Path">
                        @if (f.IsImage) { <img src="@f.Path" alt="" /> }
                        else { <span class="pf-doc"><i class="fas @DocIcon(f.FileName)"></i> @f.FileName</span> }
                        <button type="button" title="Bỏ" @onclick="() => RemoveFile(f)">×</button>
                    </div>
                }
            </div>
        }
        <div class="bar">
            <FileUpload Kind="Chat" Files="files" FilesChanged="f => files = f" ButtonText="" Camera="true" HideThumbs="true"
                        PickButtonText=" " PickIcon="fa-paperclip" Accept="@ChatAccept" AllowedExtensions="FileStorage.ChatExtensions" Class="nh-chat-up" />
            <textarea class="form-control" rows="1" placeholder="Nhắn cho mọi người..." @bind="text" @bind:event="oninput" @onkeydown="OnKey" @ref="input"></textarea>
            <button type="button" class="send" title="Gửi" disabled="@(Busy || (string.IsNullOrWhiteSpace(text) && files.Count == 0))" @onclick="SendAsync"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>
</div>

@code {
    private List<ChatMessageView> messages = [];
    private const string ChatAccept = "image/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.zip,.rar";
    private string? me, text;
    private bool isAdmin, aiReady, aiThinking, loadedAll;
    private List<PendingFile> files = [];
    private IDisposable? sub;
    private ElementReference input;

    protected override async Task OnInitializedAsync()
    {
        me = await GetUserNameAsync();
        isAdmin = await IsAdminAsync();
        aiReady = await Scanner.IsConfiguredAsync();
        messages = await Chats.GetRecentAsync();
        loadedAll = messages.Count < 100;
        if (messages.Count > 0 && me != null) await Chats.MarkReadAsync(me, messages[^1].Id);
        sub = Hub.Subscribe(OnMessageAsync);
    }

    private Task OnMessageAsync(ChatMessageView m) => InvokeAsync(async () =>
    {
        if (messages.Any(x => x.Id == m.Id)) return;
        messages.Add(m);
        if (m.IsAssistant) aiThinking = false;
        if (me != null) await Chats.MarkReadAsync(me, m.Id);
        StateHasChanged();
        await ScrollAsync();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await ScrollAsync();
    }

    private async Task ScrollAsync()
    {
        try { await JS.InvokeVoidAsync("nhChat.scrollBottom", "chatBody"); } catch (Exception) { }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !e.CtrlKey) await SendAsync();
    }

    private async Task SendAsync()
    {
        var t = (text ?? "").Trim();
        if (t.Length == 0 && files.Count == 0) return;
        var sendFiles = files.ToList();
        bool ask = t.StartsWith("@ai", StringComparison.OrdinalIgnoreCase) || t.StartsWith("/ai", StringComparison.OrdinalIgnoreCase) || t.StartsWith("@trợ lý", StringComparison.OrdinalIgnoreCase);
        if (await RunAsync(() => Chats.SendAsync(me ?? "?", t, null, sendFiles)))
        {
            text = null;
            files = [];
            if (ask && aiReady) aiThinking = true;
            try { await JS.InvokeVoidAsync("nhChat.clear", input); } catch (Exception) { }
            await ScrollAsync();
        }
    }

    private async Task LoadOlderAsync()
    {
        if (messages.Count == 0) return;
        var older = await Chats.GetRecentAsync(100, messages[0].Id);
        if (older.Count < 100) loadedAll = true;
        messages.InsertRange(0, older);
    }

    private void RemoveFile(PendingFile f) => files = files.Where(x => x != f).ToList();

    private static string DocIcon(string? name) => Path.GetExtension(name ?? "").ToLowerInvariant() switch
    {
        ".pdf" => "fa-file-pdf",
        ".doc" or ".docx" => "fa-file-word",
        ".xls" or ".xlsx" or ".csv" => "fa-file-excel",
        ".ppt" or ".pptx" => "fa-file-powerpoint",
        ".zip" or ".rar" => "fa-file-archive",
        ".txt" => "fa-file-alt",
        _ => "fa-file"
    };

    private async Task DeleteAsync(ChatMessageView m)
    {
        if (!await ConfirmAsync("Xóa tin nhắn này?")) return;
        if (await RunAsync(() => Chats.DeleteAsync(m.Id))) messages.Remove(m);
    }

    public void Dispose() => sub?.Dispose();
}
