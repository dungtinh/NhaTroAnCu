@page "/phong/{Code}"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits NhPage
@inject RoomService Rooms
@inject SetupService Setup
@inject AttachmentService Attachments

<PageTitle>Phòng @Code</PageTitle>

@if (d == null)
{
    <div class="nh-loading">@(notFound ? "Không tìm thấy phòng." : "Đang tải...")</div>
}
else
{
    var lease = d.CurrentLease;
    var active = lease?.Tenants.Where(t => t.MoveOutDate == null).OrderByDescending(t => t.IsRepresentative).ToList() ?? [];
    var rep = active.FirstOrDefault();
    var st = lease != null ? (d.Outstanding > 0 ? "st-debt" : "") : d.Room.Status == RoomStatus.Maintenance ? "st-maint" : "st-empty";
    var furDiff = furniture.Where(f => f.Quantity != f.Default).ToList();

    @* Đầu trang: mã phòng, trạng thái, tiền *@
    <div class="nh-hero-room @st">
        <div class="top">
            <div class="min-w-0">
                <div class="code">@d.Room.Code</div>
                <div class="sub">
                    @if (lease != null) { <span><i class="fas fa-user"></i> @(rep?.Tenant.FullName ?? "—") · @active.Count người · từ @Fmt.Date(lease.StartDate)</span> }
                    else { <span>@RoomStatus.Display(d.Room.Status) · tối đa @d.Room.MaxOccupants người</span> }
                </div>
            </div>
            <div class="tags">
                <span class="tag">@(lease != null ? "Đang thuê" : RoomStatus.Display(d.Room.Status))</span>
                @if (lease?.IsExistingTenant == true) { <span class="tag">Khách cũ</span> }
                @if (furDiff.Count > 0) { <span class="tag warn"><i class="fas fa-exclamation-triangle"></i> Đồ đạc khác</span> }
            </div>
        </div>
        <div class="nh-hero-stats">
            <div><div class="l">Giá thuê</div><div class="v">@Fmt.Money(lease?.MonthlyRent ?? d.Room.Rent)</div></div>
            <div><div class="l">Tiền cọc</div><div class="v">@(lease != null ? Fmt.Money(lease.Deposit) : "—")</div></div>
            <div><div class="l">Còn nợ</div><div class="v">@(lease != null ? Fmt.Money(d.Outstanding) : "—")</div></div>
        </div>
    </div>

    @* Thao tác nhanh *@
    <div class="nh-quick">
        @if (lease != null)
        {
            <a class="q-blue" href="@($"hop-dong/{lease.Id}")"><i class="fas fa-file-contract"></i>Hợp đồng &amp; người ở</a>
            <a class="q-green" href="thu-tien"><i class="fas fa-file-invoice-dollar"></i>Thu tiền tháng</a>
            <a class="q-red" href="@($"tra-phong/{lease.Id}")"><i class="fas fa-sign-out-alt"></i>Trả phòng</a>
        }
        else if (d.Room.Status != RoomStatus.Maintenance)
        {
            <a class="q-green" href="@($"nhan-phong?phong={d.Room.Code}")"><i class="fas fa-door-open"></i>Nhận phòng</a>
        }
        <a class="q-amber" href="@($"sua-chua?phong={d.Room.Code}")"><i class="fas fa-tools"></i>Ghi sửa chữa</a>
        @if (lease == null) { <a class="q-slate" href=""><i class="fas fa-th"></i>Sơ đồ</a> }
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            @if (lease != null)
            {
                <div class="nh-sec t-blue">
                    <div class="nh-sec-h">
                        <span class="ic"><i class="fas fa-users"></i></span>
                        <h5>Người ở <small>@active.Count người</small></h5>
                        <a class="btn btn-sm btn-outline-primary" href="@($"hop-dong/{lease.Id}")"><i class="fas fa-pen"></i> Sửa</a>
                    </div>
                    <div class="nh-sec-b">
                        <div class="nh-people">
                            @foreach (var t in active) { <PersonCard Link="t" /> }
                        </div>
                        @if (string.IsNullOrEmpty(lease.ContractScanPath))
                        {
                            <div class="small mt-2"><span class="chip chip-amber"><i class="fas fa-file-signature"></i> Chưa có bản scan hợp đồng</span> <a href="@($"hop-dong/{lease.Id}")">Tải lên</a></div>
                        }
                    </div>
                </div>

                <div class="nh-sec t-violet">
                    <div class="nh-sec-h">
                        <span class="ic"><i class="fas fa-id-card"></i></span>
                        <h5>Ảnh CCCD</h5>
                    </div>
                    <div class="nh-sec-b">
                        <AttachmentList EntityType="@AttachmentOwner.Room" EntityId="d.Room.Id" Kind="@AttachmentKind.IdentityCard" CanDelete="true" Version="cardVersion" />
                        <div class="mt-2"><FileUpload Kind="IdentityCards" Accept="image/*" Camera="true" ButtonText="Chụp CCCD" PickButtonText="Chọn ảnh" Files="cardPending" Uploaded="AddCardAsync" /></div>
                    </div>
                </div>

                <div class="nh-sec t-green">
                    <div class="nh-sec-h">
                        <span class="ic"><i class="fas fa-receipt"></i></span>
                        <h5>Phiếu thu <small>@d.Bills.Count phiếu · còn nợ @Fmt.Vnd(d.Outstanding)</small></h5>
                    </div>
                    <div class="nh-sec-b">
                        @if (d.Bills.Count == 0)
                        {
                            <div class="nh-empty-hint"><i class="fas fa-receipt"></i>Chưa có phiếu thu. Kỳ thu đầu lập ở trang Ghi số điện.</div>
                        }
                        <div class="nh-bills">
                            @foreach (var b in d.Bills)
                            {
                                var paid = d.BillPaid.GetValueOrDefault(b.Id);
                                <BillCard Bill="b" Paid="paid" RentDetail="@RentDetail(b)" OnPay="() => { payBill = b; payPaid = paid; }" />
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="nh-sec t-slate">
                    <div class="nh-sec-b nh-empty-hint">
                        <i class="fas fa-door-open"></i>
                        <p class="mb-2">Phòng đang @RoomStatus.Display(d.Room.Status).ToLower().</p>
                        @if (d.Room.Status != RoomStatus.Maintenance) { <a class="btn btn-success" href="@($"nhan-phong?phong={d.Room.Code}")"><i class="fas fa-door-open"></i> Nhận phòng cho khách</a> }
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-5">
            <div class="nh-sec t-amber">
                <div class="nh-sec-h">
                    <span class="ic"><i class="fas fa-couch"></i></span>
                    <h5>Đồ đạc &amp; cấu hình <small>@furniture.Count(f => f.Quantity > 0) món · tối đa @d.Room.MaxOccupants người</small></h5>
                    <button type="button" class="btn btn-sm @(editing ? "btn-secondary" : "btn-outline-warning")" @onclick="() => editing = !editing">
                        <i class="fas @(editing ? "fa-times" : "fa-pen")"></i> @(editing ? "Đóng" : "Sửa")
                    </button>
                </div>
                <div class="nh-sec-b">
                    <div class="nh-fur-chips">
                        @foreach (var f in furniture.Where(f => f.Quantity > 0 || f.Default > 0))
                        {
                            <span class="@(f.Quantity != f.Default ? "diff" : "")" title="Mặc định dãy: @f.Default">@f.Name <b>@f.Quantity</b></span>
                        }
                        @if (!furniture.Any(f => f.Quantity > 0 || f.Default > 0)) { <span class="text-muted small">Chưa có đồ đạc.</span> }
                    </div>
                    @if (furDiff.Count > 0)
                    {
                        <div class="small text-danger mt-2"><i class="fas fa-exclamation-triangle"></i> Khác mặc định dãy: @string.Join(", ", furDiff.Select(f => $"{f.Name} {f.Quantity}/{f.Default}"))</div>
                    }
                    @if (!string.IsNullOrEmpty(d.Room.Note)) { <div class="small mt-2"><i class="fas fa-sticky-note text-warning"></i> @d.Room.Note</div> }
                </div>
                @if (editing)
                {
                    <div class="nh-sec-edit">
                        <div class="row g-2">
                            <div class="col-6"><label class="form-label">Giá thuê/tháng</label><MoneyInput @bind-Value="rent" /></div>
                            <div class="col-6"><label class="form-label">Tối đa số người</label><input type="number" min="1" max="20" class="form-control" @bind="maxOcc" /></div>
                            <div class="col-12"><label class="form-label">Ghi chú</label><input class="form-control" maxlength="500" @bind="note" /></div>
                            @if (lease == null)
                            {
                                <div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" id="maint" @bind="maintenance" /><label class="form-check-label" for="maint">Đang sửa (không cho thuê)</label></div></div>
                            }
                        </div>
                        <div class="nh-fur-grid mt-2">
                            @foreach (var f in furniture)
                            {
                                <div class="nh-fur @(f.Quantity != f.Default ? "diff" : "")" @key="f.ItemId">
                                    <div class="name">@f.Name<small>mặc định dãy: @f.Default</small></div>
                                    <div class="qty">
                                        <button type="button" class="btn btn-light" @onclick="() => f.Quantity = Math.Max(0, f.Quantity - 1)"><i class="fas fa-minus"></i></button>
                                        <input type="number" min="0" max="20" class="form-control text-center" @bind="f.Quantity" />
                                        <button type="button" class="btn btn-light" @onclick="() => f.Quantity = Math.Min(20, f.Quantity + 1)"><i class="fas fa-plus"></i></button>
                                    </div>
                                </div>
                            }
                        </div>
                        <button type="button" class="btn btn-warning w-100 mt-3 fw-bold" disabled="@Busy" @onclick="SaveAsync"><i class="fas fa-save"></i> Lưu cấu hình phòng</button>
                    </div>
                }
            </div>

            @if (d.Repairs.Count > 0)
            {
                <div class="nh-sec t-rose">
                    <div class="nh-sec-h">
                        <span class="ic"><i class="fas fa-tools"></i></span>
                        <h5>Sửa chữa <small>@d.Repairs.Count lần · @Fmt.Vnd(d.Repairs.Sum(r => r.Amount))</small></h5>
                    </div>
                    <div class="nh-sec-b p0">
                        @foreach (var r in d.Repairs)
                        {
                            <a class="nh-list-row" href="@($"sua-chua/{r.Id}")">
                                <div class="main"><div class="t">@r.Description</div><div class="s">@Fmt.Date(r.Date)@(r.FurnitureItem != null ? " · " + r.FurnitureItem.Name : "")@(string.IsNullOrEmpty(r.PerformedBy) ? "" : " · " + r.PerformedBy)</div></div>
                                <div class="amt">@Fmt.Money(r.Amount)</div>
                                <i class="fas fa-chevron-right text-muted"></i>
                            </a>
                        }
                    </div>
                </div>
            }

            @if (d.PastLeases.Count > 0)
            {
                <div class="nh-sec t-slate">
                    <div class="nh-sec-h">
                        <span class="ic"><i class="fas fa-history"></i></span>
                        <h5>Các lượt thuê trước <small>@d.PastLeases.Count lượt</small></h5>
                    </div>
                    <div class="nh-sec-b p0">
                        @foreach (var l in d.PastLeases)
                        {
                            <a class="nh-list-row" href="@($"hop-dong/{l.Id}")">
                                <div class="main">
                                    <div class="t">@(l.Tenants.OrderByDescending(t => t.IsRepresentative).Select(t => t.Tenant.FullName).FirstOrDefault())</div>
                                    <div class="s">@Fmt.Date(l.StartDate) → @Fmt.Date(l.EndDate)@((l.CheckoutPenalty ?? 0) > 0 ? $" · phạt {Fmt.Money(l.CheckoutPenalty ?? 0)}" : "")</div>
                                </div>
                                <div class="amt small text-muted">trả cọc @Fmt.Money(l.DepositRefunded ?? 0)</div>
                                <i class="fas fa-chevron-right text-muted"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <PaymentDialog Bill="payBill" Paid="payPaid" RoomCode="@d.Room.Code" Closed="() => payBill = null" Saved="AfterPaymentAsync" />
}

@code {
    [Parameter] public string Code { get; set; } = "";
    private RoomDetails? d;
    private int billingDay = 10;
    private bool notFound, editing;
    private string RentDetail(Bill b) => d?.CurrentLease == null ? "" : LeaseService.RentDetail(b, d.CurrentLease, billingDay);
    private decimal rent;
    private int maxOcc;
    private string? note;
    private bool maintenance;
    private List<FurnitureEdit> furniture = [];
    private Bill? payBill;
    private decimal payPaid;
    private List<PendingFile> cardPending = [];
    private int cardVersion;

    private async Task AddCardAsync(PendingFile f)
    {
        var user = await GetUserNameAsync();
        if (await RunAsync(() => Attachments.AddAsync(AttachmentOwner.Room, d!.Room.Id, [f with { Kind = AttachmentKind.IdentityCard }], user)))
        {
            cardPending.Clear();
            cardVersion++;
        }
    }

    private class FurnitureEdit
    {
        public int ItemId { get; set; }
        public string Name { get; set; } = "";
        public int Quantity { get; set; }
        public int Default { get; set; }
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        d = await Rooms.GetDetailsAsync(Code);
        billingDay = (await Setup.GetSettingsAsync()).BillingDay;
        notFound = d == null;
        if (d == null) return;
        rent = d.Room.Rent;
        maxOcc = d.Room.MaxOccupants;
        note = d.Room.Note;
        maintenance = d.Room.Status == RoomStatus.Maintenance;
        furniture = d.Furniture.Select(f => new FurnitureEdit { ItemId = f.ItemId, Name = f.Name, Quantity = f.Quantity, Default = f.DefaultQuantity }).ToList();
    }

    private async Task SaveAsync()
    {
        if (d == null) return;
        if (await RunAsync(() => Rooms.UpdateRoomAsync(d.Room.Id, rent, maxOcc, note, maintenance, furniture.ToDictionary(f => f.ItemId, f => f.Quantity)),
                $"Đã lưu cấu hình phòng {d.Room.Code}."))
        {
            editing = false;
            await LoadAsync();
        }
    }

    private async Task AfterPaymentAsync()
    {
        payBill = null;
        await LoadAsync();
    }
}
