@* Biểu đồ thanh ngang đơn giản theo danh mục (thay Chart.js của bản cũ, không cần JavaScript). *@
@if (Items.Count == 0)
{
    <p class="text-muted">Không có dữ liệu.</p>
}
else
{
    var total = Items.Sum(i => i.Amount);
    var max = Items.Max(i => i.Amount);
    @foreach (var (category, amount) in Items)
    {
        <div class="mb-2">
            <div class="d-flex justify-content-between small">
                <span>@category</span>
                <span><strong>@Fmt.Money(amount) đ</strong> (@(total > 0 ? (amount / total * 100).ToString("0.#") : "0")%)</span>
            </div>
            <div class="bg-light rounded">
                <div class="nh-chart-bar @Css" style="width: @((max > 0 ? amount / max * 100 : 0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public List<(string Category, decimal Amount)> Items { get; set; } = [];
    [Parameter] public string Css { get; set; } = "";
}
