@page "/IncomeExpense"
@page "/IncomeExpense/Index"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits NhPage
@inject IncomeExpenseService Service

<PageTitle>Quản lý Thu Chi</PageTitle>
<HeadContent><link rel="stylesheet" href="css/legacy/income-expense.css" /></HeadContent>

<div class="income-expense-container">
    <div class="page-header">
        <h2><i class="fas fa-money-check-alt"></i> Quản lý Thu Chi</h2>
        <div class="header-actions">
            <a href="IncomeExpense/Create" class="btn btn-success"><i class="fas fa-plus"></i> Thêm giao dịch</a>
            <a href="IncomeExpense/Categories" class="btn btn-info"><i class="fas fa-list"></i> Quản lý danh mục</a>
            <a href="IncomeExpense/Report" class="btn btn-primary"><i class="fas fa-chart-bar"></i> Xem báo cáo</a>
        </div>
    </div>

    @if (data != null)
    {
        <div class="summary-cards">
            <div class="summary-card income"><div class="card-icon"><i class="fas fa-arrow-down"></i></div><div class="card-content"><div class="card-label">Tổng thu</div><div class="card-value">@Fmt.Money(data.TotalIncome) đ</div></div></div>
            <div class="summary-card expense"><div class="card-icon"><i class="fas fa-arrow-up"></i></div><div class="card-content"><div class="card-label">Tổng chi</div><div class="card-value">@Fmt.Money(data.TotalExpense) đ</div></div></div>
            <div class="summary-card balance @(data.Balance >= 0 ? "positive" : "negative")"><div class="card-icon"><i class="fas fa-balance-scale"></i></div><div class="card-content"><div class="card-label">Cân đối</div><div class="card-value">@Fmt.Money(data.Balance) đ</div></div></div>
        </div>
    }

    <div class="filter-section">
        <div class="row g-2 align-items-end">
            <div class="col-md-2"><label>Từ ngày</label><input type="date" class="form-control" @bind="filter.FromDate" /></div>
            <div class="col-md-2"><label>Đến ngày</label><input type="date" class="form-control" @bind="filter.ToDate" /></div>
            <div class="col-md-3">
                <label>Danh mục</label>
                <select class="form-control" @bind="filter.CategoryId">
                    <option value="">-- Tất cả danh mục --</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id">@CategoryType.Display(c.Type) - @c.Name@(c.IsActive ? "" : " (ẩn)")</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label>Loại</label>
                <select class="form-control" @bind="filter.Type">
                    <option value="">-- Tất cả --</option>
                    <option value="@CategoryType.Income">Thu</option>
                    <option value="@CategoryType.Expense">Chi</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="button" class="btn btn-primary" @onclick="SearchAsync"><i class="fas fa-filter"></i> Lọc</button>
                <button type="button" class="btn btn-secondary" @onclick="ResetAsync"><i class="fas fa-redo"></i> Làm mới</button>
            </div>
        </div>
    </div>

    <div class="table-container">
        @if (data == null)
        {
            <div class="nh-loading"><i class="fas fa-spinner fa-spin fa-2x"></i></div>
        }
        else if (data.Items.Count == 0)
        {
            <p class="text-center text-muted py-4 mb-0">Chưa có giao dịch nào.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr><th>Ngày</th><th>Danh mục</th><th>Loại</th><th class="text-end">Số tiền</th><th>Mô tả</th><th>Phòng</th><th>Số chứng từ</th><th width="150">Thao tác</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in data.Items)
                        {
                            <tr @key="item.Id">
                                <td>@Fmt.Date(item.TransactionDate)</td>
                                <td>@item.CategoryName</td>
                                <td><span class="badge @(item.Type == CategoryType.Income ? "bg-success" : "bg-danger")">@CategoryType.Display(item.Type)</span></td>
                                <td class="text-end fw-bold @(item.Type == CategoryType.Income ? "text-success" : "text-danger")">@(item.Type == CategoryType.Income ? "+" : "-")@Fmt.Money(item.Amount) đ</td>
                                <td>@item.Description</td>
                                <td>
                                    @if (item.ContractId is int cid)
                                    {
                                        <a href="@($"Contracts/Details/{cid}")">@item.ContractInfo</a>
                                    }
                                </td>
                                <td><small>@item.ReferenceNumber</small></td>
                                <td>
                                    <a href="@($"IncomeExpense/Edit/{item.Id}")" class="btn btn-sm btn-warning" title="Sửa"><i class="fas fa-edit"></i></a>
                                    @if (item.CategoryName == SystemCategories.RoomPayment && item.ContractId != null)
                                    {
                                        <a href="@($"files/receipts/{item.Id}")" target="_blank" class="btn btn-sm btn-outline-primary" title="In hóa đơn"><i class="fas fa-file-pdf"></i></a>
                                    }
                                    <button type="button" class="btn btn-sm btn-danger" title="Xóa" @onclick="() => DeleteAsync(item.Id)"><i class="fas fa-trash"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                <small class="text-muted">Tổng @data.TotalItems giao dịch</small>
                <Pager Page="filter.Page" PageSize="filter.PageSize" TotalItems="data.TotalItems" PageChanged="GoAsync" />
            </div>
        }
    </div>
</div>

@code {
    private TransactionFilter filter = new();
    private TransactionList? data;
    private List<IncomeExpenseCategory> categories = [];

    protected override async Task OnInitializedAsync()
    {
        categories = await Service.ListCategoriesAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => data = await Service.ListAsync(filter);

    private async Task SearchAsync()
    {
        filter.Page = 1;
        await LoadAsync();
    }

    private async Task ResetAsync()
    {
        filter = new TransactionFilter();
        await LoadAsync();
    }

    private async Task GoAsync(int page)
    {
        filter.Page = page;
        await LoadAsync();
    }

    private async Task DeleteAsync(int id)
    {
        if (!await ConfirmAsync("Xóa giao dịch này?")) return;
        if (await RunAsync(() => Service.DeleteAsync(id), "Đã xóa giao dịch thành công.")) await LoadAsync();
    }
}
