@page "/IncomeExpense/Create"
@page "/IncomeExpense/Edit/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits NhPage
@inject IncomeExpenseService Service

<PageTitle>@(IsCreate ? "Thêm giao dịch" : "Sửa giao dịch")</PageTitle>
<HeadContent><link rel="stylesheet" href="css/legacy/income-expence-action.css" /></HeadContent>

<div class="container">
    <div class="card shadow-sm" style="max-width: 860px; margin: 0 auto;">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fas @(IsCreate ? "fa-plus-circle" : "fa-edit")"></i> @(IsCreate ? "Thêm giao dịch thu chi" : $"Sửa giao dịch #{Id}")</h4>
        </div>
        <div class="card-body">
            @if (form == null)
            {
                <div class="nh-loading">@(notFound ? "Không tìm thấy giao dịch." : "Đang tải...")</div>
            }
            else
            {
                @if (lockedSystem)
                {
                    <div class="alert alert-info small"><i class="fas fa-lock"></i> Giao dịch thuộc danh mục hệ thống "@systemCategoryName", không đổi được danh mục.</div>
                }
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Danh mục <span class="text-danger">*</span></label>
                        <select class="form-control" @bind="form.CategoryId" disabled="@lockedSystem">
                            <option value="0">-- Chọn danh mục --</option>
                            @foreach (var g in categories.GroupBy(c => c.Type))
                            {
                                <optgroup label="@(g.Key == CategoryType.Income ? "Thu" : "Chi")">
                                    @foreach (var c in g)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Số tiền <span class="text-danger">*</span></label>
                        <MoneyInput @bind-Value="form.Amount" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngày giao dịch <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" @bind="form.TransactionDate" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Hợp đồng (không bắt buộc)</label>
                        <select class="form-control" @bind="form.ContractId">
                            <option value="">-- Không gắn hợp đồng --</option>
                            @foreach (var c in contracts)
                            {
                                <option value="@c.Id">@c.Display</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Mô tả</label>
                        <input class="form-control" maxlength="500" @bind="form.Description" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Số chứng từ</label>
                        <input class="form-control" maxlength="50" @bind="form.ReferenceNumber" placeholder="Tự sinh nếu để trống" />
                    </div>
                </div>
                <div class="mt-4">
                    <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="SaveAsync"><i class="fas fa-save"></i> Lưu</button>
                    <a href="IncomeExpense" class="btn btn-secondary ms-2">Hủy</a>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }
    private bool IsCreate => Id == null;
    private TransactionForm? form;
    private bool notFound;
    private List<IncomeExpenseCategory> categories = [];
    private List<ContractOption> contracts = [];
    private bool lockedSystem;
    private string? systemCategoryName;

    protected override async Task OnInitializedAsync()
    {
        var all = await Service.ListCategoriesAsync();
        contracts = await Service.ListActiveContractsAsync();
        if (IsCreate)
        {
            form = new TransactionForm();
            categories = all.Where(c => c.IsActive && !c.IsSystem).ToList();
            return;
        }

        form = await Service.GetFormAsync(Id!.Value);
        notFound = form == null;
        if (form == null) return;
        var current = all.FirstOrDefault(c => c.Id == form.CategoryId);
        lockedSystem = current?.IsSystem == true;
        systemCategoryName = current?.Name;
        categories = all.Where(c => (c.IsActive && !c.IsSystem) || c.Id == form.CategoryId).ToList();
        if (form.ContractId is int cid && contracts.All(c => c.Id != cid))
            contracts.Insert(0, new ContractOption(cid, $"HĐ #{cid}"));
    }

    private async Task SaveAsync()
    {
        var userId = await GetUserIdAsync();
        if (await RunAsync(() => Service.SaveAsync(form!, userId), IsCreate ? "Đã thêm giao dịch thành công!" : "Đã cập nhật giao dịch thành công!"))
            Nav.NavigateTo("IncomeExpense");
    }
}
