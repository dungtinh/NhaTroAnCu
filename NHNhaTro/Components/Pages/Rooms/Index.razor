@page "/"
@page "/Rooms"
@page "/Rooms/Index"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits NhPage
@inject RoomService Rooms

<PageTitle>Quản lý phòng trọ</PageTitle>
<HeadContent><link rel="stylesheet" href="css/legacy/room-index.css" /><link rel="stylesheet" href="css/legacy/room-index-inline.css" /></HeadContent>

<div class="container-fluid">
    <div class="dashboard-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h1 class="dashboard-title"><i class="fas fa-home"></i> Quản lý phòng trọ</h1>
        <a href="Rooms/Create" class="btn btn-light"><i class="fas fa-plus"></i> Thêm phòng</a>
    </div>

    <div class="filter-card">
        <h3 class="filter-title"><i class="fas fa-calendar-alt"></i> Lọc theo thời gian</h3>
        <div class="row g-2">
            <div class="col-md-3">
                <label>Ngày:</label>
                <input type="number" class="form-control date-input" min="1" max="31" @bind="day" />
            </div>
            <div class="col-md-3">
                <label>Tháng:</label>
                <input type="number" class="form-control date-input" min="1" max="12" @bind="month" />
            </div>
            <div class="col-md-3">
                <label>Năm:</label>
                <input type="number" class="form-control date-input" min="2020" max="2100" @bind="year" />
            </div>
            <div class="col-md-3">
                <label>&nbsp;</label>
                <button type="button" class="btn btn-primary form-control" @onclick="LoadAsync"><i class="fas fa-filter"></i> Lọc</button>
            </div>
        </div>
        <div class="month-selector mt-3">
            @for (int i = 1; i <= 12; i++)
            {
                var m = i;
                <a href="javascript:void(0)" class="month-btn @(m == month ? "month-selected" : "")" @onclick="() => SelectMonth(m)">Tháng @m</a>
            }
        </div>
    </div>

    @if (data == null)
    {
        <div class="nh-loading"><i class="fas fa-spinner fa-spin fa-2x"></i></div>
    }
    else
    {
        <div class="summary-dashboard">
            <div class="summary-grid">
                <div class="summary-card"><i class="fas fa-door-open summary-icon"></i><div class="summary-value">@data.Total</div><div class="summary-label">Tổng số phòng</div></div>
                <div class="summary-card occupied"><i class="fas fa-users summary-icon"></i><div class="summary-value">@data.Rented</div><div class="summary-label">Phòng đã thuê</div></div>
                <div class="summary-card"><i class="fas fa-door-closed summary-icon"></i><div class="summary-value">@data.Empty</div><div class="summary-label">Phòng trống</div></div>
                <div class="summary-card overdue"><i class="fas fa-exclamation-triangle summary-icon"></i><div class="summary-value">@data.Expired</div><div class="summary-label">Hết hạn HĐ</div></div>
                <div class="summary-card efficiency"><i class="fas fa-chart-pie summary-icon"></i><div class="summary-value">@data.OccupancyRate.ToString("P0", Fmt.Vi)</div><div class="summary-label">Tỷ lệ lấp đầy</div></div>
            </div>
        </div>

        @if (data.Rooms.Count == 0)
        {
            <div class="area-section text-center">
                <p class="mb-3">Chưa có phòng nào.</p>
                <a href="Rooms/Create" class="btn btn-primary"><i class="fas fa-plus"></i> Thêm phòng đầu tiên</a>
            </div>
        }

        @foreach (var area in data.Rooms.GroupBy(r => r.Room.Area).OrderBy(g => g.Key))
        {
            <div class="area-section">
                <h2 class="area-title"><i class="fas fa-building"></i> Khu @area.Key</h2>
                @foreach (var floor in area.GroupBy(r => r.Room.Floor).OrderBy(g => g.Key))
                {
                    <div class="floor-section">
                        <h3 class="floor-title"><i class="fas fa-layer-group"></i> Tầng @floor.Key</h3>
                        <div class="room-grid">
                            @foreach (var item in floor.OrderBy(r => r.Room.RoomNumber).ThenBy(r => r.Room.Name))
                            {
                                <div class="room-card room-@item.Color @item.Color" @key="item.Room.Id">
                                    <a href="@($"Rooms/Edit/{item.Room.Id}")" class="edit-icon" title="Sửa phòng"><i class="fas fa-edit"></i></a>
                                    <a href="@($"Rooms/History/{item.Room.Id}")" class="history-icon" title="Lịch sử"><i class="fas fa-history"></i></a>
                                    <div class="room-number">@item.Room.Name</div>
                                    <div class="room-tenant">
                                        @if (!string.IsNullOrEmpty(item.TenantName))
                                        {
                                            <span>@item.TenantName</span>
                                        }
                                        else
                                        {
                                            <span style="opacity: .6">Trống</span>
                                        }
                                    </div>
                                    @if (item.IsNearingEnd)
                                    {
                                        <div class="badge bg-warning text-dark mb-2"><i class="fas fa-clock"></i> Sắp hết HĐ</div>
                                    }
                                    @if (item.IsExpired)
                                    {
                                        <div class="badge bg-danger mb-2"><i class="fas fa-exclamation-circle"></i> Hết hạn HĐ</div>
                                    }
                                    <div class="room-actions">
                                        <a href="@($"Rooms/Details/{item.Room.Id}")" class="btn-room"><i class="fas fa-eye"></i> Chi tiết</a>
                                        @if (item.ContractId == null)
                                        {
                                            <button type="button" class="btn-room" title="Đánh dấu có người ở không hợp đồng" @onclick="() => ToggleOccupied(item.Room.Id)">
                                                <i class="fas @(item.Room.IsOccupied ? "fa-user-slash" : "fa-user-check")"></i> @(item.Room.IsOccupied ? "Bỏ đánh dấu" : "Có người ở")
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<div class="container-fluid mt-4">
    <div class="filter-card">
        <h4 class="mb-3"><i class="fas fa-palette"></i> Chú thích màu sắc</h4>
        <div class="row g-2">
            <div class="col-md-3"><span class="badge" style="background:#95a5a6"><i class="fas fa-square"></i> Xám - Phòng trống</span></div>
            <div class="col-md-3"><span class="badge" style="background:#3498db"><i class="fas fa-square"></i> Xanh dương - Đang thuê, chưa có phiếu báo</span></div>
            <div class="col-md-3"><span class="badge" style="background:#27ae60"><i class="fas fa-square"></i> Xanh lá - Đã thanh toán</span></div>
            <div class="col-md-3"><span class="badge" style="background:#f39c12"><i class="fas fa-square"></i> Vàng - Thanh toán một phần</span></div>
            <div class="col-md-3"><span class="badge" style="background:#e67e22"><i class="fas fa-square"></i> Cam - Chưa thanh toán</span></div>
            <div class="col-md-3"><span class="badge" style="background:#e74c3c"><i class="fas fa-square"></i> Đỏ - Hết hạn hợp đồng</span></div>
            <div class="col-md-3"><span class="badge" style="background:#9b59b6"><i class="fas fa-square"></i> Tím - Có người ở không HĐ</span></div>
        </div>
    </div>
</div>

@code {
    private RoomDashboard? data;
    private int day, month, year;

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.Today;
        month = now.Month;
        year = now.Year;
        day = DateTime.DaysInMonth(year, month);
        await LoadAsync();
    }

    private async Task SelectMonth(int m)
    {
        month = m;
        day = DateTime.DaysInMonth(year, month);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        month = Math.Clamp(month, 1, 12);
        year = Math.Clamp(year, 2000, 2100);
        day = Math.Clamp(day, 1, DateTime.DaysInMonth(year, month));
        data = await Rooms.GetDashboardAsync(new DateTime(year, month, day));
    }

    private async Task ToggleOccupied(int roomId)
    {
        if (await RunAsync(() => Rooms.ToggleOccupiedAsync(roomId))) await LoadAsync();
    }
}
