@* Một ô tiện ích dạng công tắc trên form phòng. *@
<div class="checkbox-group @(Value ? "checked" : "")">
    <div class="checkbox-wrapper">
        <input type="checkbox" id="@inputId" checked="@Value" @onchange="OnChange" />
        <span class="checkbox-slider"></span>
    </div>
    <label for="@inputId" class="checkbox-label">
        <i class="fas @Icon checkbox-icon"></i> @Label
    </label>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "fa-check";
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    private readonly string inputId = "amenity-" + Guid.NewGuid().ToString("N")[..8];

    private async Task OnChange(ChangeEventArgs e)
    {
        Value = e.Value is true || e.Value?.ToString() == "true";
        await ValueChanged.InvokeAsync(Value);
    }
}
