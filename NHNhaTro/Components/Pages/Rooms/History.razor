@page "/Rooms/History/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits NhPage
@inject RoomService Rooms

<PageTitle>Lịch sử phòng @m?.Room.Name</PageTitle>
<HeadContent><link rel="stylesheet" href="css/legacy/room-report.css" /></HeadContent>

@if (m == null)
{
    <div class="nh-loading">@(notFound ? "Không tìm thấy phòng." : "Đang tải...")</div>
}
else
{
    <div class="history-container">
        <a href="@($"Rooms/Details/{m.Room.Id}")" class="btn-back"><i class="fas fa-arrow-left"></i> Quay lại chi tiết phòng</a>

        <div class="history-header">
            <div class="header-content">
                <div class="header-info">
                    <h1><i class="fas fa-history"></i> Lịch Sử Phòng @m.Room.Name</h1>
                    <div>
                        <span class="room-tag"><i class="fas fa-layer-group"></i> Tầng @m.Room.Floor</span>
                        <span class="room-tag"><i class="fas fa-ruler-combined"></i> Dãy @m.Room.Area</span>
                        <span class="room-tag"><i class="fas @(m.Room.IsOccupied ? "fa-user-check" : "fa-door-open")"></i> @(m.Room.IsOccupied ? "Đang cho thuê" : "Phòng trống")</span>
                    </div>
                </div>
                <div class="header-stats">
                    <div class="stat-item"><span class="stat-value">@m.Contracts.Count</span><span class="stat-label">Hợp đồng</span></div>
                    <div class="stat-item"><span class="stat-value">@m.Tenants.Count</span><span class="stat-label">Người thuê</span></div>
                    <div class="stat-item"><span class="stat-value">@Fmt.Money(m.TotalRevenue)</span><span class="stat-label">Tổng thu (VNĐ)</span></div>
                </div>
            </div>
        </div>

        <div class="nav-tabs">
            <button type="button" class="nav-tab @(tab == "overview" ? "active" : "")" @onclick='() => tab = "overview"'><i class="fas fa-chart-line"></i> Tổng quan</button>
            <button type="button" class="nav-tab @(tab == "contracts" ? "active" : "")" @onclick='() => tab = "contracts"'><i class="fas fa-file-contract"></i> Hợp đồng <span class="badge-count">@m.Contracts.Count</span></button>
            <button type="button" class="nav-tab @(tab == "tenants" ? "active" : "")" @onclick='() => tab = "tenants"'><i class="fas fa-users"></i> Người thuê <span class="badge-count">@m.Tenants.Count</span></button>
            <button type="button" class="nav-tab @(tab == "payments" ? "active" : "")" @onclick='() => tab = "payments"'><i class="fas fa-money-bill-wave"></i> Thanh toán <span class="badge-count">@m.Payments.Count</span></button>
        </div>

        @if (tab == "overview")
        {
            <div class="tab-content active">
                <div class="stats-grid">
                    <div class="stat-card blue"><div class="stat-icon"><i class="fas fa-calendar-alt"></i></div><h3>@m.TotalMonthsRented</h3><p>Tổng tháng đã cho thuê</p></div>
                    <div class="stat-card green"><div class="stat-icon"><i class="fas fa-percentage"></i></div><h3>@m.OccupancyRate%</h3><p>Tỷ lệ lấp đầy (12 tháng)</p></div>
                    <div class="stat-card purple"><div class="stat-icon"><i class="fas fa-coins"></i></div><h3>@Fmt.Money(m.AverageMonthlyRevenue)</h3><p>Thu nhập trung bình/tháng (VNĐ)</p></div>
                    <div class="stat-card orange"><div class="stat-icon"><i class="fas fa-hourglass-half"></i></div><h3>@m.AverageContractDuration</h3><p>Thời gian HĐ trung bình (tháng)</p></div>
                </div>
                @if (m.CurrentContract is { } cur)
                {
                    <div class="timeline-card" style="background: linear-gradient(135deg, #dcfce7, #bbf7d0);">
                        <h3 style="color: #16a34a; margin-bottom: 20px;"><i class="fas fa-check-circle"></i> Hợp đồng hiện tại</h3>
                        <div class="payment-grid">
                            <div class="payment-stat"><div class="payment-label">Khách thuê</div><div class="payment-amount">@string.Join(", ", cur.TenantNames)</div></div>
                            <div class="payment-stat"><div class="payment-label">Bắt đầu</div><div class="payment-amount">@Fmt.Date(cur.StartDate)</div></div>
                            <div class="payment-stat"><div class="payment-label">Kết thúc</div><div class="payment-amount">@Fmt.Date(cur.EndDate)</div></div>
                            <div class="payment-stat"><div class="payment-label">Giá thuê</div><div class="payment-amount">@Fmt.Money(cur.MonthlyRent) ₫</div></div>
                        </div>
                    </div>
                }
                <div class="timeline-card">
                    <h3 style="margin-bottom: 20px; color: #1f2937;"><i class="fas fa-chart-bar"></i> Thống kê thanh toán</h3>
                    <div class="payment-grid">
                        <div class="payment-stat"><div class="payment-amount">@Fmt.Money(m.TotalRevenue) ₫</div><div class="payment-label">Tổng đã thu</div></div>
                        <div class="payment-stat"><div class="payment-amount">@Fmt.Money(m.TotalDebt) ₫</div><div class="payment-label">Tổng còn nợ</div></div>
                        <div class="payment-stat"><div class="payment-amount">@m.PaymentCompleteRate%</div><div class="payment-label">Tỷ lệ thanh toán</div></div>
                    </div>
                </div>
            </div>
        }
        else if (tab == "contracts")
        {
            <div class="tab-content active">
                @if (m.Contracts.Count == 0)
                {
                    <div class="empty-state"><i class="fas fa-folder-open empty-icon"></i><h3>Chưa có hợp đồng nào</h3></div>
                }
                else
                {
                    <div class="timeline">
                        @foreach (var c in m.Contracts)
                        {
                            bool active = c.Status != ContractStatus.Ended;
                            <div class="timeline-item">
                                <div class="timeline-dot @(active ? "active" : "ended")"></div>
                                <div class="timeline-card">
                                    <div class="timeline-header">
                                        <div class="contract-info">
                                            <h4><a href="@($"Contracts/Details/{c.Id}")"><i class="fas fa-file-signature"></i> Hợp đồng #@c.Id</a></h4>
                                            <div class="contract-dates"><i class="fas fa-calendar"></i> @Fmt.Date(c.StartDate) - @Fmt.Date(c.EndDate) (@Fmt.MonthsBetween(c.StartDate, c.EndDate) tháng)</div>
                                        </div>
                                        <span class="contract-status @(active ? "status-active" : "status-ended")">@ContractStatus.Display(c.Status)</span>
                                    </div>
                                    @if (c.TenantNames.Count > 0)
                                    {
                                        <div class="tenant-list">
                                            @foreach (var name in c.TenantNames)
                                            {
                                                <div class="tenant-card">
                                                    <div class="tenant-avatar">@(name.Length > 0 ? name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Last()[..1].ToUpper() : "?")</div>
                                                    <div class="tenant-info"><div class="tenant-name">@name</div></div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    <div class="payment-summary">
                                        <div class="payment-grid">
                                            <div class="payment-stat"><div class="payment-amount">@Fmt.Money(c.MonthlyRent) ₫</div><div class="payment-label">Giá thuê/tháng</div></div>
                                            <div class="payment-stat"><div class="payment-amount">@Fmt.Money(c.TotalPaid) ₫</div><div class="payment-label">Đã thanh toán</div></div>
                                            <div class="payment-stat"><div class="payment-amount">@Fmt.Money(c.TotalDebt) ₫</div><div class="payment-label">Còn nợ</div></div>
                                            <div class="payment-stat"><div class="payment-amount">@c.PaymentRate%</div><div class="payment-label">Tỷ lệ thanh toán</div></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else if (tab == "tenants")
        {
            var tenants = m.Tenants
                .Where(t => string.IsNullOrWhiteSpace(tenantSearch) || t.FullName.Contains(tenantSearch, StringComparison.OrdinalIgnoreCase) || t.IdentityCard.Contains(tenantSearch))
                .Where(t => tenantStatus == "" || (tenantStatus == "current") == t.IsCurrent)
                .ToList();
            <div class="tab-content active">
                <div class="filter-bar">
                    <div class="filter-group"><label>Tìm kiếm người thuê</label><input type="text" class="form-control" placeholder="Nhập tên hoặc CCCD..." @bind="tenantSearch" @bind:event="oninput" /></div>
                    <div class="filter-group">
                        <label>Trạng thái</label>
                        <select class="form-control" @bind="tenantStatus">
                            <option value="">Tất cả</option>
                            <option value="current">Đang thuê</option>
                            <option value="moved">Đã chuyển</option>
                        </select>
                    </div>
                </div>
                @if (tenants.Count == 0)
                {
                    <div class="empty-state"><i class="fas fa-users empty-icon"></i><h3>Chưa có người thuê</h3></div>
                }
                else
                {
                    <div class="payment-table">
                        <table class="table">
                            <thead><tr><th>Người thuê</th><th>CCCD</th><th>Số điện thoại</th><th>Thời gian thuê</th><th>Trạng thái</th></tr></thead>
                            <tbody>
                                @foreach (var t in tenants)
                                {
                                    <tr>
                                        <td><div style="font-weight: 600;">@t.FullName</div><div style="font-size: .85rem; color: #6b7280;">@t.Gender</div></td>
                                        <td>@t.IdentityCard</td>
                                        <td>@t.PhoneNumber</td>
                                        <td>@Fmt.Date(t.MoveInDate) - @(t.MoveOutDate.HasValue ? Fmt.Date(t.MoveOutDate) : "Hiện tại")</td>
                                        <td><span class="payment-status @(t.IsCurrent ? "status-paid" : "status-unpaid")">@(t.IsCurrent ? "Đang thuê" : "Đã chuyển")</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
        else
        {
            var payments = m.Payments
                .Where(p => fromMonth == null || new DateTime(p.Year, p.Month, 1) >= new DateTime(fromMonth.Value.Year, fromMonth.Value.Month, 1))
                .Where(p => toMonth == null || new DateTime(p.Year, p.Month, 1) <= new DateTime(toMonth.Value.Year, toMonth.Value.Month, 1))
                .Where(p => paymentStatus == "" || p.Status == paymentStatus)
                .ToList();
            <div class="tab-content active">
                <div class="filter-bar">
                    <div class="filter-group"><label>Từ tháng</label><input type="month" class="form-control" @bind="fromMonth" /></div>
                    <div class="filter-group"><label>Đến tháng</label><input type="month" class="form-control" @bind="toMonth" /></div>
                    <div class="filter-group">
                        <label>Trạng thái</label>
                        <select class="form-control" @bind="paymentStatus">
                            <option value="">Tất cả</option>
                            <option value="Paid">Đã thanh toán</option>
                            <option value="Partial">Thanh toán một phần</option>
                            <option value="Unpaid">Chưa thanh toán</option>
                        </select>
                    </div>
                </div>
                @if (payments.Count == 0)
                {
                    <div class="empty-state"><i class="fas fa-receipt empty-icon"></i><h3>Chưa có lịch sử thanh toán</h3></div>
                }
                else
                {
                    <div class="payment-table">
                        <table class="table">
                            <thead><tr><th>Tháng/Năm</th><th>Hợp đồng</th><th>Phải thu</th><th>Đã thu</th><th>Còn lại</th><th>Trạng thái</th><th>Ngày thu</th></tr></thead>
                            <tbody>
                                @foreach (var p in payments)
                                {
                                    <tr>
                                        <td><span class="payment-month">@p.Month/@p.Year</span></td>
                                        <td><a href="@($"Contracts/Details/{p.ContractId}")">#@p.ContractId</a></td>
                                        <td>@Fmt.Vnd(p.BillAmount)</td>
                                        <td class="text-success">@Fmt.Vnd(p.PaidAmount)</td>
                                        <td class="@(p.Remaining > 0 ? "text-danger" : "")">@Fmt.Vnd(p.Remaining)</td>
                                        <td>
                                            <span class="payment-status @(p.Status switch { "Paid" => "status-paid", "Partial" => "status-partial", _ => "status-unpaid" })">
                                                @(p.Status switch { "Paid" => "Đã thanh toán", "Partial" => "Một phần", _ => "Chưa thanh toán" })
                                            </span>
                                        </td>
                                        <td>@Fmt.Date(p.PaymentDate)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private RoomHistory? m;
    private bool notFound;
    private string tab = "overview";
    private string tenantSearch = "";
    private string tenantStatus = "";
    private DateTime? fromMonth, toMonth;
    private string paymentStatus = "";

    protected override async Task OnParametersSetAsync()
    {
        m = await Rooms.GetHistoryAsync(Id);
        notFound = m == null;
    }
}
