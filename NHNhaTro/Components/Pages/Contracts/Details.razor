@page "/Contracts/Details/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits NhPage
@inject ContractService Contracts

<PageTitle>Hợp đồng #@Id</PageTitle>
<HeadContent><link rel="stylesheet" href="css/legacy/contract-details.css" /></HeadContent>

@if (c == null)
{
    <div class="nh-loading">@(notFound ? "Không tìm thấy hợp đồng." : "Đang tải...")</div>
}
else
{
    var statusClass = c.Status switch { ContractStatus.Active => "status-active", ContractStatus.Expired => "status-expired", _ => "status-ended" };
    var totalBilled = c.UtilityBills.Sum(b => b.TotalAmount);
    var totalPaid = c.IncomeExpenses.Where(i => i.Category.Name == SystemCategories.RoomPayment).Sum(i => i.Amount);
    int months = Fmt.MonthsBetween(c.StartDate, c.EndDate);

    <div class="contract-details-container">
        <div class="contract-header">
            <div class="contract-header-content">
                <div class="contract-title">
                    <h1><i class="fas fa-file-contract"></i> Hợp đồng <span class="contract-id">#@c.Id</span></h1>
                    <div class="contract-meta">
                        <div class="meta-item"><i class="fas fa-calendar"></i> @Fmt.Date(c.StartDate) - @Fmt.Date(c.EndDate)</div>
                        <div class="meta-item"><i class="fas fa-@(c.IsCompany ? "building" : "user")"></i> @ContractType.Display(c.ContractType)</div>
                        <span class="status-badge @statusClass"><i class="fas fa-circle"></i> @ContractStatus.Display(c.Status)</span>
                    </div>
                </div>
                <div class="header-actions">
                    @if (c.Status != ContractStatus.Ended)
                    {
                        <a href="@($"Contracts/Edit/{c.Id}")" class="btn-action"><i class="fas fa-edit"></i> Sửa</a>
                        <a href="@($"Contracts/Extend/{c.Id}")" class="btn-action"><i class="fas fa-clock"></i> Gia hạn</a>
                        <a href="@($"Contracts/End/{c.Id}")" class="btn-action"><i class="fas fa-stop"></i> Kết thúc</a>
                    }
                    <a href="@($"files/contracts/{c.Id}/print")" target="_blank" class="btn-action"><i class="fas fa-print"></i> In</a>
                    <button type="button" class="btn-action" @onclick="DeleteAsync"><i class="fas fa-trash"></i> Xóa</button>
                </div>
            </div>
        </div>

        @if (c.IsCompany && c.Company != null)
        {
            <div class="company-section">
                <div class="company-header">
                    <div class="company-logo"><i class="fas fa-building"></i></div>
                    <div class="company-info">
                        <h3>@c.Company.CompanyName</h3>
                        <div class="company-tax"><i class="fas fa-barcode"></i> MST: @c.Company.TaxCode</div>
                    </div>
                </div>
                <div class="info-grid" style="margin-top: 20px;">
                    <div class="info-row"><span class="info-label"><i class="fas fa-user-tie"></i> Người đại diện:</span><span class="info-value">@c.Company.Representative</span></div>
                    <div class="info-row"><span class="info-label"><i class="fas fa-phone"></i> Điện thoại:</span><span class="info-value">@(c.Company.RepresentativePhone ?? c.Company.Phone)</span></div>
                    <div class="info-row"><span class="info-label"><i class="fas fa-envelope"></i> Email:</span><span class="info-value">@c.Company.Email</span></div>
                    <div class="info-row"><span class="info-label"><i class="fas fa-map-marker-alt"></i> Địa chỉ:</span><span class="info-value">@c.Company.Address</span></div>
                </div>
            </div>
        }

        <div class="info-grid">
            <div class="info-card">
                <div class="card-header"><div class="card-icon"><i class="fas fa-info-circle"></i></div><h3 class="card-title">Thông Tin Chung</h3></div>
                <div class="info-row"><span class="info-label">Ngày bắt đầu:</span><span class="info-value">@Fmt.Date(c.StartDate)</span></div>
                <div class="info-row"><span class="info-label">Ngày kết thúc:</span><span class="info-value">@Fmt.Date(c.EndDate)</span></div>
                <div class="info-row"><span class="info-label">Thời hạn:</span><span class="info-value">@months tháng</span></div>
                <div class="info-row"><span class="info-label">Ngày chuyển vào:</span><span class="info-value">@Fmt.Date(c.MoveInDate)</span></div>
                <div class="info-row"><span class="info-label">Ghi chú:</span><span class="info-value" style="white-space: pre-line">@c.Note</span></div>
                @if (!string.IsNullOrEmpty(c.ContractScanFilePath))
                {
                    <div class="info-row"><span class="info-label">Bản scan:</span><span class="info-value"><a href="@c.ContractScanFilePath" target="_blank"><i class="fas fa-paperclip"></i> Xem file</a></span></div>
                }
            </div>
            <div class="info-card">
                <div class="card-header"><div class="card-icon"><i class="fas fa-dollar-sign"></i></div><h3 class="card-title">Thông Tin Giá</h3></div>
                <div class="info-row"><span class="info-label">Giá điện:</span><span class="info-value">@Fmt.Money(c.ElectricityPrice)đ/kWh</span></div>
                <div class="info-row"><span class="info-label">Giá nước:</span><span class="info-value">@Fmt.Money(c.WaterPrice)đ/m³</span></div>
                <div class="info-row"><span class="info-label">Tổng giá thuê/tháng:</span><span class="info-value highlight">@Fmt.Vnd(c.PriceAgreed)</span></div>
                <div class="info-row"><span class="info-label">Số phòng:</span><span class="info-value">@c.ContractRooms.Count phòng</span></div>
                <div class="info-row"><span class="info-label">Tổng phiếu báo / đã thu:</span><span class="info-value">@Fmt.Vnd(totalBilled) / @Fmt.Vnd(totalPaid)</span></div>
                <div class="info-row">
                    <span class="info-label">Số dư (cọc):</span>
                    <span class="info-value @(totalPaid - totalBilled >= 0 ? "text-success" : "text-danger")">@Fmt.Vnd(totalPaid - totalBilled)</span>
                </div>
            </div>
        </div>

        <div class="rooms-section">
            <div class="section-header"><div class="section-title"><i class="fas fa-door-open"></i> Danh Sách Phòng (@c.ContractRooms.Count)</div></div>
            <div class="rooms-grid">
                @foreach (var cr in c.ContractRooms.OrderBy(x => x.Room.Name))
                {
                    var count = c.ContractTenants.Count(ct => ct.RoomId == cr.RoomId);
                    <div class="room-card">
                        <div class="room-number"><a href="@($"Rooms/Details/{cr.RoomId}")"><i class="fas fa-home"></i> @cr.Room.Name</a></div>
                        <div class="room-price">@Fmt.Vnd(cr.PriceAgreed)/tháng</div>
                        <div class="small text-muted">@count người thuê @(string.IsNullOrEmpty(cr.Notes) ? "" : " · " + cr.Notes)</div>
                        <a class="btn btn-sm btn-outline-primary mt-2" href="@($"ContractTenants/TenantManager?contractId={c.Id}&roomId={cr.RoomId}")"><i class="fas fa-user-plus"></i> Quản lý người thuê</a>
                    </div>
                }
            </div>
        </div>

        <div class="tenants-section">
            <div class="section-header"><div class="section-title"><i class="fas fa-users"></i> Danh Sách Người Thuê (@c.ContractTenants.Count)</div></div>
            @if (c.ContractTenants.Count > 0)
            {
                <div class="tenants-grid">
                    @foreach (var ct in c.ContractTenants.OrderBy(x => x.Room.Name).ThenBy(x => x.CreatedAt))
                    {
                        <div class="tenant-card">
                            <div class="tenant-avatar">
                                @if (ct.Tenant.PhotoList.FirstOrDefault() is { } photo)
                                {
                                    <img src="@photo" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:50%" />
                                }
                                else
                                {
                                    <i class="fas fa-user"></i>
                                }
                            </div>
                            <div class="tenant-name">@ct.Tenant.FullName</div>
                            <div class="tenant-info">
                                <div class="tenant-detail"><i class="fas fa-phone"></i> @ct.Tenant.PhoneNumber</div>
                                <div class="tenant-detail"><i class="fas fa-id-card"></i> @ct.Tenant.IdentityCard</div>
                                <div class="tenant-detail"><i class="fas fa-door-open"></i> @ct.Room.Name</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4"><i class="fas fa-users" style="font-size: 48px; margin-bottom: 15px;"></i><p>Chưa có người thuê</p></div>
            }
        </div>

        <div class="financial-summary">
            <div class="section-title" style="color: white;"><i class="fas fa-chart-line"></i> Tổng Quan Tài Chính</div>
            <div class="summary-grid">
                <div class="summary-item"><div class="summary-value">@Fmt.Vnd(c.PriceAgreed)</div><div class="summary-label">Tiền thuê/tháng</div></div>
                <div class="summary-item"><div class="summary-value">@c.ContractRooms.Count</div><div class="summary-label">Số phòng</div></div>
                <div class="summary-item"><div class="summary-value">@c.ContractTenants.Count</div><div class="summary-label">Số người thuê</div></div>
                <div class="summary-item"><div class="summary-value">@Fmt.Vnd(c.PriceAgreed * Math.Max(months, 0))</div><div class="summary-label">Tổng giá trị HĐ</div></div>
            </div>
        </div>

        @if (c.ContractExtensionHistories.Count > 0)
        {
            <div class="info-card">
                <div class="card-header"><div class="card-icon"><i class="fas fa-history"></i></div><h3 class="card-title">Lịch Sử Gia Hạn</h3></div>
                <div class="history-timeline">
                    @foreach (var h in c.ContractExtensionHistories.OrderByDescending(x => x.ExtendedAt))
                    {
                        <div class="history-item">
                            <div class="history-marker"></div>
                            <div class="history-content">
                                <div class="history-date"><i class="fas fa-calendar"></i> @Fmt.Date(h.ExtendedAt)</div>
                                <div>Từ @Fmt.Date(h.OldEndDate) đến @Fmt.Date(h.NewEndDate)</div>
                                @if (!string.IsNullOrEmpty(h.Note))
                                {
                                    <div><i class="fas fa-sticky-note"></i> @h.Note</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="bottom-actions">
            <a href="Contracts" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Danh sách hợp đồng</a>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private Contract? c;
    private bool notFound;

    protected override async Task OnParametersSetAsync()
    {
        c = await Contracts.GetDetailsAsync(Id);
        notFound = c == null;
    }

    private async Task DeleteAsync()
    {
        if (!await ConfirmAsync($"Xóa hẳn hợp đồng #{Id}? Phiếu báo và người thuê gắn với hợp đồng cũng bị xóa. Không thể hoàn tác.")) return;
        if (await RunAsync(() => Contracts.DeleteAsync(Id), "Đã xóa hợp đồng thành công."))
            Nav.NavigateTo("Contracts");
    }
}
