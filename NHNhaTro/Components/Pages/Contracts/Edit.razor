@page "/Contracts/Edit/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits NhPage
@inject ContractService Contracts

<PageTitle>Sửa hợp đồng #@Id</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="css/legacy/contract-action.css" />
    <link rel="stylesheet" href="css/legacy/contract-edit-inline.css" />
</HeadContent>

<div class="contract-form-container">
    <div class="form-header">
        <h2><i class="fas fa-edit"></i> Sửa Hợp Đồng #@Id</h2>
        @if (form != null)
        {
            <p>@ContractType.Display(form.ContractType)@(form.IsCompany && !string.IsNullOrEmpty(form.Company.CompanyName) ? " - " + form.Company.CompanyName : "")</p>
        }
    </div>

    @if (form == null)
    {
        <div class="nh-loading">@(notFound ? "Không tìm thấy hợp đồng." : "Đang tải...")</div>
    }
    else
    {
        <div class="form-section">
            <div class="section-title"><i class="fas fa-info-circle"></i> Thông Tin Hợp Đồng</div>
            <div class="form-row">
                <div class="form-group"><label>Ngày bắt đầu</label><input type="date" class="form-control" @bind="form.StartDate" /></div>
                <div class="form-group"><label>Ngày kết thúc</label><input type="date" class="form-control" @bind="form.EndDate" /></div>
                <div class="form-group"><label>Ngày chuyển vào</label><input type="date" class="form-control" @bind="form.MoveInDate" /></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Giá điện (đ/kWh)</label><MoneyInput @bind-Value="form.ElectricityPrice" /></div>
                <div class="form-group"><label>Giá nước (đ/m³)</label><MoneyInput @bind-Value="form.WaterPrice" /></div>
                <div class="form-group">
                    <label>Trạng thái</label>
                    <select class="form-control" @bind="form.Status">
                        <option value="@ContractStatus.Active">Đang hiệu lực</option>
                        <option value="@ContractStatus.Expired">Đã hết hạn</option>
                        <option value="@ContractStatus.Ended">Đã kết thúc</option>
                    </select>
                </div>
            </div>
            <div class="form-group"><label>Ghi chú</label><textarea class="form-control" rows="3" maxlength="500" @bind="form.Note"></textarea></div>
            <div class="form-group">
                <label>File scan hợp đồng (PDF, JPG, PNG, tối đa 10MB)</label>
                @if (!string.IsNullOrEmpty(form.ContractScanFilePath))
                {
                    <div class="mb-2"><a href="@form.ContractScanFilePath" target="_blank"><i class="fas fa-paperclip"></i> File hiện tại</a></div>
                }
                <InputFile class="form-control" accept=".pdf,.jpg,.jpeg,.png" OnChange="OnScanSelected" />
                @if (scanFile != null)
                {
                    <small class="text-success">Đã chọn: @scanFile.Name (@(scanFile.Size / 1024) KB)</small>
                }
            </div>
        </div>

        @if (form.IsCompany)
        {
            <div class="form-section">
                <div class="section-title"><i class="fas fa-building"></i> Thông Tin Công Ty</div>
                <CompanyFields Company="form.Company" AutoFill="false" />
                <div class="alert alert-warning small"><i class="fas fa-exclamation-triangle"></i> Bỏ chọn một phòng sẽ gỡ người thuê của phòng đó khỏi hợp đồng.</div>
                <CompanyRoomPicker Rooms="form.Rooms" />
            </div>
        }
        else
        {
            <div class="form-section">
                <div class="section-title"><i class="fas fa-door-open"></i> Phòng</div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Phòng</label>
                        <select class="form-control" @bind="form.RoomId">
                            @foreach (var r in form.Rooms)
                            {
                                <option value="@r.RoomId">@r.RoomName - @Fmt.Money(r.DefaultPrice) VNĐ</option>
                            }
                        </select>
                        <small class="text-muted">Đổi phòng sẽ chuyển cả người thuê sang phòng mới.</small>
                    </div>
                    <div class="form-group"><label>Giá thuê (đ/tháng)</label><MoneyInput Value="form.RoomPrice ?? 0" ValueChanged="v => form.RoomPrice = v" /></div>
                </div>
                <div class="form-group"><label>Ghi chú phòng</label><input class="form-control" @bind="form.RoomNotes" /></div>
                @if (form.RoomId is int rid)
                {
                    <a class="btn btn-outline-primary" href="@($"ContractTenants/TenantManager?contractId={form.Id}&roomId={rid}")"><i class="fas fa-users"></i> Quản lý người thuê</a>
                }
            </div>
        }

        <div class="text-center mb-4">
            <button type="button" class="btn-submit btn btn-primary btn-lg" disabled="@Busy" @onclick="SaveAsync"><i class="fas @(Busy ? "fa-spinner fa-spin" : "fa-save")"></i> Lưu thay đổi</button>
            <a href="@($"Contracts/Details/{Id}")" class="btn btn-secondary btn-lg" style="margin-left: 10px;"><i class="fas fa-times"></i> Hủy</a>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private ContractForm? form;
    private bool notFound;
    private IBrowserFile? scanFile;

    protected override async Task OnParametersSetAsync()
    {
        form = await Contracts.GetEditFormAsync(Id);
        notFound = form == null;
    }

    private void OnScanSelected(InputFileChangeEventArgs e)
    {
        scanFile = e.File;
        if (scanFile.Size > FileStorage.MaxScanSize)
        {
            Toast.Error("File scan không được vượt quá 10MB.");
            scanFile = null;
        }
    }

    private async Task SaveAsync()
    {
        if (form == null) return;
        var ok = await RunAsync(async () =>
        {
            if (scanFile != null)
            {
                await using var stream = scanFile.OpenReadStream(FileStorage.MaxScanSize);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                buffer.Position = 0;
                await Contracts.UpdateAsync(form, buffer, scanFile.Name);
            }
            else
            {
                await Contracts.UpdateAsync(form);
            }
        }, "Đã cập nhật hợp đồng thành công!");
        if (ok) Nav.NavigateTo($"Contracts/Details/{Id}");
    }
}
