@page "/Contracts/Extend/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits NhPage
@inject ContractService Contracts

<PageTitle>Gia hạn hợp đồng #@Id</PageTitle>
<HeadContent><link rel="stylesheet" href="css/legacy/contract-details.css" /></HeadContent>

<div class="contract-details-container">
    @if (c == null)
    {
        <div class="nh-loading">@(notFound ? "Không tìm thấy hợp đồng." : "Đang tải...")</div>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="fas fa-calendar-plus"></i> Gia hạn hợp đồng #@c.Id</h4>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Loại:</strong> @ContractType.Display(c.ContractType) @(c.Company != null ? "- " + c.Company.CompanyName : "")</p>
                        <p class="mb-1"><strong>Phòng:</strong> @string.Join(", ", c.ContractRooms.Select(cr => cr.Room.Name))</p>
                        <p class="mb-1"><strong>Người thuê:</strong> @(c.ContractTenants.Count > 0 ? string.Join(", ", c.ContractTenants.Select(ct => ct.Tenant.FullName)) : "—")</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Ngày bắt đầu:</strong> @Fmt.Date(c.StartDate)</p>
                        <p class="mb-1"><strong>Ngày kết thúc hiện tại:</strong> <span class="text-danger fw-bold">@Fmt.Date(c.EndDate)</span></p>
                        <p class="mb-1"><strong>Trạng thái:</strong> @ContractStatus.Display(c.Status)</p>
                    </div>
                </div>

                @if (c.ContractExtensionHistories.Count > 0)
                {
                    <h6><i class="fas fa-history"></i> Lịch sử gia hạn</h6>
                    <table class="table table-sm table-bordered">
                        <thead class="table-light"><tr><th>Ngày gia hạn</th><th>Từ ngày</th><th>Đến ngày</th><th>Ghi chú</th></tr></thead>
                        <tbody>
                            @foreach (var h in c.ContractExtensionHistories.OrderByDescending(x => x.ExtendedAt))
                            {
                                <tr><td>@Fmt.DateTime(h.ExtendedAt)</td><td>@Fmt.Date(h.OldEndDate)</td><td>@Fmt.Date(h.NewEndDate)</td><td>@h.Note</td></tr>
                            }
                        </tbody>
                    </table>
                }

                @if (c.Status == ContractStatus.Ended)
                {
                    <div class="alert alert-danger">Không thể gia hạn hợp đồng đã kết thúc.</div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label">Gia hạn nhanh</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var m in new[] { 1, 3, 6, 12 })
                            {
                                var months = m;
                                <button type="button" class="btn btn-outline-primary" @onclick="() => newEndDate = c.EndDate.AddMonths(months)">+@months tháng</button>
                            }
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Ngày kết thúc mới</label>
                            <input type="date" class="form-control" @bind="newEndDate" />
                            <small class="text-muted">Thời gian gia hạn: @Math.Max(0, Fmt.MonthsBetween(c.EndDate, newEndDate)) tháng (@Math.Max(0, (newEndDate - c.EndDate).Days) ngày)</small>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Ghi chú gia hạn</label>
                            <input class="form-control" maxlength="255" @bind="note" placeholder="VD: Gia hạn thêm 6 tháng, giữ nguyên giá" />
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="SaveAsync"><i class="fas fa-check"></i> Xác nhận gia hạn</button>
                        <a href="@($"Contracts/Details/{c.Id}")" class="btn btn-secondary ms-2">Hủy</a>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Contract? c;
    private bool notFound;
    private DateTime newEndDate;
    private string? note;

    protected override async Task OnParametersSetAsync()
    {
        c = await Contracts.GetDetailsAsync(Id);
        notFound = c == null;
        if (c != null) newEndDate = c.EndDate.AddMonths(6);
    }

    private async Task SaveAsync()
    {
        if (await RunAsync(() => Contracts.ExtendAsync(Id, newEndDate, note), $"Đã gia hạn hợp đồng đến ngày {newEndDate:dd/MM/yyyy}."))
            Nav.NavigateTo($"Contracts/Details/{Id}");
    }
}
