@page "/Contracts"
@page "/Contracts/Index"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits NhPage
@inject ContractService Contracts

<PageTitle>Quản lý Hợp đồng</PageTitle>
<HeadContent><link rel="stylesheet" href="css/legacy/contract-index.css" /></HeadContent>

<div class="container-fluid">
    <div class="dashboard-header">
        <h1 class="dashboard-title"><i class="fas fa-file-contract"></i> Quản lý Hợp đồng</h1>
        <div class="dashboard-subtitle">Quản lý tất cả hợp đồng thuê nhà của bạn</div>
    </div>

    @if (result != null)
    {
        <div class="stats-container">
            <div class="stat-card total"><i class="fas fa-file-alt stat-icon"></i><div class="stat-value">@result.TotalCount</div><div class="stat-label">Tổng hợp đồng</div></div>
            <div class="stat-card active"><i class="fas fa-check-circle stat-icon"></i><div class="stat-value">@result.ActiveCount</div><div class="stat-label">Đang hiệu lực</div></div>
            <div class="stat-card warning"><i class="fas fa-exclamation-triangle stat-icon"></i><div class="stat-value">@result.NearExpiryCount</div><div class="stat-label">Sắp hết hạn</div></div>
            <div class="stat-card expired"><i class="fas fa-times-circle stat-icon"></i><div class="stat-value">@result.ExpiredCount</div><div class="stat-label">Đã hết hạn</div></div>
            <div class="stat-card ended"><i class="fas fa-archive stat-icon"></i><div class="stat-value">@result.EndedCount</div><div class="stat-label">Đã kết thúc</div></div>
            <div class="stat-card value"><i class="fas fa-dollar-sign stat-icon"></i><div class="stat-value">@Fmt.Money(result.TotalActiveValue)</div><div class="stat-label">Tổng giá trị/tháng</div></div>
        </div>
    }

    <div class="filter-section">
        <h3 class="filter-title"><i class="fas fa-filter"></i> Bộ lọc tìm kiếm</h3>
        <div class="filter-row">
            <div class="filter-group">
                <label>Tìm kiếm</label>
                <input type="text" class="form-control" placeholder="Mã HĐ, phòng, tên, CCCD, công ty..." @bind="filter.SearchTerm" @onkeyup="OnSearchKey" />
            </div>
            <div class="filter-group">
                <label>Loại hợp đồng</label>
                <select class="form-control" @bind="filter.ContractType">
                    <option value="">-- Tất cả --</option>
                    <option value="@ContractType.Individual">Cá nhân/Hộ gia đình</option>
                    <option value="@ContractType.Company">Công ty</option>
                </select>
            </div>
            <div class="filter-group">
                <label>Trạng thái</label>
                <select class="form-control" @bind="filter.Status">
                    <option value="">-- Tất cả --</option>
                    <option value="@ContractStatus.Active">Đang hiệu lực</option>
                    <option value="@ContractStatus.Expired">Đã hết hạn</option>
                    <option value="@ContractStatus.Ended">Đã kết thúc</option>
                    <option value="NearExpiry">Sắp hết hạn (30 ngày)</option>
                </select>
            </div>
            <div class="filter-group">
                <label>Công ty</label>
                <select class="form-control" @bind="filter.CompanyId">
                    <option value="">-- Tất cả --</option>
                    @foreach (var c in companies)
                    {
                        <option value="@c.Id">@c.CompanyName</option>
                    }
                </select>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-group"><label>Từ ngày</label><input type="date" class="form-control" @bind="filter.FromDate" /></div>
            <div class="filter-group"><label>Đến ngày</label><input type="date" class="form-control" @bind="filter.ToDate" /></div>
            <div class="filter-group">
                <label>Hiển thị</label>
                <select class="form-control" @bind="filter.PageSize">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>
        <div class="filter-buttons">
            <button type="button" class="btn-filter btn-primary" @onclick="SearchAsync"><i class="fas fa-search"></i> Tìm kiếm</button>
            <button type="button" class="btn-filter btn-secondary" @onclick="ResetAsync"><i class="fas fa-redo"></i> Đặt lại</button>
            <a href="Contracts/Create" class="btn-filter btn-success"><i class="fas fa-plus"></i> Tạo hợp đồng</a>
            <a href="@ExportUrl" class="btn-filter btn-info" target="_blank"><i class="fas fa-file-excel"></i> Xuất Excel</a>
        </div>
    </div>

    @if (selected.Count > 0)
    {
        <div class="batch-operations">
            <span><strong>@selected.Count</strong> hợp đồng được chọn</span>
            <button type="button" class="btn btn-danger btn-sm ms-3" @onclick="BatchEndAsync"><i class="fas fa-stop"></i> Kết thúc hàng loạt</button>
            <button type="button" class="btn btn-secondary btn-sm ms-2" @onclick="() => selected.Clear()">Bỏ chọn</button>
        </div>
    }

    @if (result == null)
    {
        <div class="nh-loading"><i class="fas fa-spinner fa-spin fa-2x"></i></div>
    }
    else if (result.Items.Count == 0)
    {
        <div class="no-data">
            <i class="fas fa-folder-open fa-3x"></i>
            <h3>Không có hợp đồng nào</h3>
            <a href="Contracts/Create" class="btn btn-primary mt-2"><i class="fas fa-plus"></i> Tạo hợp đồng mới</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table contracts-table">
                <thead>
                    <tr>
                        <th class="checkbox-column"><input type="checkbox" checked="@AllSelected" @onchange="ToggleAll" /></th>
                        <th class="cursor-pointer" @onclick='() => SortAsync("id")'>Mã HĐ <i class="fas fa-sort"></i></th>
                        <th>Loại HĐ</th>
                        <th>Phòng</th>
                        <th>Khách thuê/Công ty</th>
                        <th class="cursor-pointer" @onclick='() => SortAsync("Date")'>Ngày bắt đầu <i class="fas fa-sort"></i></th>
                        <th class="cursor-pointer" @onclick='() => SortAsync("EndDate")'>Ngày kết thúc <i class="fas fa-sort"></i></th>
                        <th>Giá thuê</th>
                        <th class="cursor-pointer" @onclick='() => SortAsync("Status")'>Trạng thái <i class="fas fa-sort"></i></th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in result.Items)
                    {
                        var days = (item.EndDate - DateTime.Today).Days;
                        var rowClass = item.Status == ContractStatus.Expired ? "table-danger"
                            : item.Status == ContractStatus.Ended ? "table-secondary"
                            : days <= 30 ? "table-warning" : "";
                        <tr class="@rowClass" @key="item.Id">
                            <td><input type="checkbox" checked="@selected.Contains(item.Id)" @onchange="() => ToggleOne(item.Id)" /></td>
                            <td><strong>#@item.Id</strong></td>
                            <td>
                                @if (item.IsCompany)
                                {
                                    <span class="badge badge-info bg-info">Công ty</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary bg-secondary">Cá nhân</span>
                                }
                            </td>
                            <td><div class="room-list">@foreach (var r in item.ContractRooms) {<span class="room-tag">@r.Room.Name</span>}</div></td>
                            <td>
                                @if (item.IsCompany)
                                {
                                    <strong>@item.Company?.CompanyName</strong>
                                }
                                else if (item.ContractTenants.Count > 0)
                                {
                                    <span>@string.Join(", ", item.ContractTenants.OrderBy(ct => ct.CreatedAt).Select(ct => ct.Tenant.FullName))</span>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa có người thuê</span>
                                }
                            </td>
                            <td>@Fmt.Date(item.StartDate)</td>
                            <td>
                                @Fmt.Date(item.EndDate)
                                @if (days <= 30 && days > 0 && item.Status == ContractStatus.Active)
                                {
                                    <br /><small class="text-warning"><i class="fas fa-exclamation-triangle"></i> Còn @days ngày</small>
                                }
                            </td>
                            <td><strong>@Fmt.Money(item.PriceAgreed) đ</strong></td>
                            <td>
                                <span class="badge @(item.Status switch { ContractStatus.Active => "badge-success bg-success", ContractStatus.Expired => "badge-danger bg-danger", _ => "badge-secondary bg-secondary" })">@ContractStatus.Display(item.Status)</span>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <a href="@($"Contracts/Details/{item.Id}")" class="btn-action btn-view" title="Xem chi tiết"><i class="fas fa-eye"></i></a>
                                    @if (item.Status != ContractStatus.Ended)
                                    {
                                        <a href="@($"Contracts/Edit/{item.Id}")" class="btn-action btn-edit" title="Sửa"><i class="fas fa-edit"></i></a>
                                        <a href="@($"Contracts/Extend/{item.Id}")" class="btn-action btn-extend" title="Gia hạn"><i class="fas fa-calendar-plus"></i></a>
                                        <a href="@($"Contracts/End/{item.Id}")" class="btn-action btn-end" title="Kết thúc"><i class="fas fa-stop"></i></a>
                                    }
                                    <a href="@($"files/contracts/{item.Id}/print")" class="btn-action btn-info" title="In hợp đồng" target="_blank"><i class="fas fa-print"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-3">
            <Pager Page="filter.Page" PageSize="filter.PageSize" TotalItems="result.TotalCount" PageChanged="GoToPageAsync" />
        </div>
    }
</div>

@code {
    private ContractFilter filter = new();
    private ContractListResult? result;
    private List<Company> companies = [];
    private readonly HashSet<int> selected = [];

    [SupplyParameterFromQuery] public string? Status { get; set; }

    private bool AllSelected => result != null && result.Items.Count > 0 && result.Items.All(i => selected.Contains(i.Id));

    private string ExportUrl
    {
        get
        {
            var q = new Dictionary<string, object?>
            {
                ["searchTerm"] = filter.SearchTerm,
                ["contractType"] = filter.ContractType,
                ["status"] = filter.Status,
                ["fromDate"] = filter.FromDate?.ToString("yyyy-MM-dd"),
                ["toDate"] = filter.ToDate?.ToString("yyyy-MM-dd"),
                ["companyId"] = filter.CompanyId
            };
            return Nav.GetUriWithQueryParameters(Nav.BaseUri + "files/contracts.xlsx", q);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        filter.Status = Status;
        companies = await Contracts.ListCompaniesAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        result = await Contracts.ListAsync(filter);
        selected.IntersectWith(result.Items.Select(i => i.Id));
    }

    private async Task SearchAsync()
    {
        filter.Page = 1;
        await LoadAsync();
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchAsync();
    }

    private async Task ResetAsync()
    {
        filter = new ContractFilter();
        await LoadAsync();
    }

    private async Task SortAsync(string column)
    {
        var desc = column switch { "id" => "id_desc", "Date" => "date_desc", "EndDate" => "enddate_desc", "Status" => "status_desc", _ => "" };
        filter.SortOrder = filter.SortOrder == column ? desc : column;
        if (column == "id" && string.IsNullOrEmpty(filter.SortOrder)) filter.SortOrder = "id";
        await LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        filter.Page = page;
        await LoadAsync();
    }

    private void ToggleOne(int id)
    {
        if (!selected.Remove(id)) selected.Add(id);
    }

    private void ToggleAll()
    {
        if (result == null) return;
        if (AllSelected) selected.Clear();
        else selected.UnionWith(result.Items.Select(i => i.Id));
    }

    private async Task BatchEndAsync()
    {
        if (!await ConfirmAsync($"Kết thúc {selected.Count} hợp đồng đã chọn? Các phòng sẽ được trả về trạng thái trống.")) return;
        int count = 0;
        if (await RunAsync(async () => count = await Contracts.BatchEndAsync(selected)))
        {
            Toast.Success($"Đã kết thúc {count} hợp đồng.");
            selected.Clear();
            await LoadAsync();
        }
    }
}
