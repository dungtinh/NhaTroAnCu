@page "/nhan-phong"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits NhPage
@inject RoomService Rooms
@inject LeaseService Leases
@inject SetupService Setup
@inject CompanyService Companies

<PageTitle>Nhận phòng</PageTitle>

<div class="nh-page-title">
    <h2><i class="fas fa-door-open"></i> Nhận phòng</h2>
</div>

@if (settings == null)
{
    <div class="nh-loading">Đang tải...</div>
}
else
{
    var stub = room == null ? null : LeaseService.CalculateStubPeriod(form.MonthlyRent, form.MoveInDate, settings.BillingDay);
    decimal total = (company == null ? form.MonthlyRent : 0) + form.Deposit;
    var people = form.Tenants.Where(t => !t.IsEmpty).ToList();
    var furDiff = furniture.Where(f => f.Quantity != f.Default).ToList();

    @* 3 bước ngắn, mỗi bước một màn hình: Phòng (giá, cọc, đồ đạc) → Khách (CCCD, chân dung) → Tiền & xác nhận *@
    <div class="nh-steps nh-steps-lg">
        <button type="button" class="nh-step @(step == 1 ? "on" : room != null ? "done" : "")" @onclick="() => Go(1)"><span>1</span> Phòng@(room != null ? " " + room.Code : "")</button>
        <button type="button" class="nh-step @(step == 2 ? "on" : step > 2 ? "done" : "")" disabled="@(room == null)" @onclick="() => Go(2)"><span>2</span> Khách@(people.Count > 0 ? $" ({people.Count})" : "")</button>
        <button type="button" class="nh-step @(step == 3 ? "on" : "")" disabled="@(room == null)" @onclick="() => Go(3)"><span>3</span> Thu tiền</button>
    </div>

    @if (step == 1)
    {
        <div class="nh-card">
            <h5><i class="fas fa-door-closed"></i> Chọn phòng trống</h5>
            <RoomPicker Mode="RoomPicker.PickMode.Empty" PresetCode="@RoomCode" Picked="OnPicked" />
        </div>
        @if (room != null && details != null)
        {
            <div class="nh-card">
                <h5><i class="fas fa-calendar-check"></i> Ngày vào, giá, cọc</h5>
                @if (companies.Count > 0)
                {
                    <div class="mb-2">
                        <label class="form-label">Bên thuê</label>
                        <select class="form-select" value="@(company?.Id.ToString() ?? "")" @onchange="OnCompanyChanged">
                            <option value="">Khách lẻ</option>
                            @foreach (var c in companies) { <option value="@c.Id">Hợp đồng công ty @c.ShortName (@c.CompanyName)</option> }
                        </select>
                        @if (company != null)
                        {
                            <div class="small text-info-emphasis mt-1"><i class="fas fa-building"></i> Phòng thuộc HĐ @company.ShortName: không thu tháng trả trước, tiền phòng thu theo kỳ @company.RentMonthsPerPeriod tháng
                                (vào giữa kỳ tính từ ngày vào), nước @Fmt.Money(company.WaterPerRoom)đ/phòng/tháng, tối đa @company.MaxOccupantsPerRoom người.</div>
                        }
                    </div>
                }
                <div class="row g-2">
                    <div class="col-6 col-md-4"><label class="form-label">Ngày vào</label><input type="date" class="form-control" @bind="form.MoveInDate" /></div>
                    <div class="col-6 col-md-4"><label class="form-label">Tiền phòng/tháng</label><MoneyInput @bind-Value="form.MonthlyRent" /></div>
                    <div class="col-6 col-md-4"><label class="form-label">Tiền cọc</label><MoneyInput @bind-Value="form.Deposit" /></div>
                </div>
                @if (form.MonthlyRent != details.Room.Rent)
                {
                    <div class="small text-warning-emphasis mt-2"><i class="fas fa-info-circle"></i> Giá phòng @room.Code sẽ đổi từ @Fmt.Vnd(details.Room.Rent) thành @Fmt.Vnd(form.MonthlyRent).</div>
                }
                @if (form.Deposit != settings.DefaultDeposit && company == null)
                {
                    <div class="small text-muted mt-1">Cọc mặc định theo cấu hình là @Fmt.Vnd(settings.DefaultDeposit).</div>
                }
            </div>

            <div class="nh-card">
                <h5><i class="fas fa-couch"></i> Đồ đạc trong phòng <span class="small fw-normal text-muted">· kiểm và sửa số lượng thực tế</span></h5>
                <div class="nh-fur-grid">
                    @foreach (var f in furniture)
                    {
                        <div class="nh-fur @(f.Quantity != f.Default ? "diff" : "")" @key="f.ItemId">
                            <div class="name">@f.Name<small>mặc định dãy: @f.Default</small></div>
                            <div class="qty">
                                <button type="button" class="btn btn-light" @onclick="() => f.Quantity = Math.Max(0, f.Quantity - 1)"><i class="fas fa-minus"></i></button>
                                <input type="number" min="0" max="20" class="form-control text-center" @bind="f.Quantity" />
                                <button type="button" class="btn btn-light" @onclick="() => f.Quantity = Math.Min(20, f.Quantity + 1)"><i class="fas fa-plus"></i></button>
                            </div>
                        </div>
                    }
                </div>
                @if (furDiff.Count > 0)
                {
                    <div class="small text-warning-emphasis mt-2"><i class="fas fa-exclamation-triangle"></i> Khác mặc định của dãy: @string.Join(", ", furDiff.Select(f => $"{f.Name} {f.Quantity}/{f.Default}")). Sẽ lưu vào cấu hình phòng khi nhận phòng.</div>
                }
                <div class="row g-2 mt-1">
                    <div class="col-5 col-md-3"><label class="form-label">Tối đa số người</label><input type="number" min="1" max="20" class="form-control" @bind="maxPeople" /></div>
                    <div class="col-7 col-md-9"><label class="form-label">Ghi chú hợp đồng</label><input class="form-control" maxlength="1000" @bind="form.Note" /></div>
                </div>
            </div>
        }
    }
    else if (step == 2)
    {
        <div class="nh-card">
            <h5><i class="fas fa-users"></i> Khách thuê phòng @room!.Code <span class="small fw-normal text-muted">· chụp CCCD 2 mặt và ảnh chân dung, hoặc chọn ảnh có sẵn</span></h5>
            @if (company != null)
            {
                <div class="small text-info-emphasis mb-2"><i class="fas fa-passport"></i> Nhân viên @company.ShortName: nhập số hộ chiếu vào ô CCCD. Chưa có giấy tờ thì để trống,
                    phần mềm ghi tạm "Nhân viên @company.ShortName (chưa có tên)" để bổ sung sau ở trang hợp đồng.</div>
            }
            <TenantEditor Tenants="form.Tenants" MaxPeople="maxPeople" Compact="true" Changed="StateHasChanged" />
        </div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-lg-6">
                <div class="nh-card">
                    <h5><i class="fas fa-clipboard-check"></i> Xem lại</h5>
                    <table class="nh-table mb-0">
                        <tr><td>Phòng</td><td class="text-end fw-bold">@room!.Code · @Fmt.Vnd(form.MonthlyRent)/tháng</td></tr>
                        <tr><td>Ngày vào</td><td class="text-end">@Fmt.Date(form.MoveInDate)</td></tr>
                        <tr><td>Người ở (@people.Count)</td><td class="text-end">@string.Join(", ", people.Select(p => p.FullName))</td></tr>
                        @if (furDiff.Count > 0)
                        {
                            <tr><td>Đồ đạc khác mặc định</td><td class="text-end small">@string.Join(", ", furDiff.Select(f => $"{f.Name} {f.Quantity}/{f.Default}"))</td></tr>
                        }
                    </table>
                    <div class="d-flex gap-2 mt-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Go(1)"><i class="fas fa-pen"></i> Sửa phòng</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Go(2)"><i class="fas fa-pen"></i> Sửa khách</button>
                    </div>
                </div>

                <div class="nh-card">
                    <h5><i class="fas fa-calculator"></i> Kỳ thu tiếp theo</h5>
                    <div class="small">
                        @if (company != null)
                        {
                            <div class="mb-1">Tiền phòng: phiếu kỳ hợp đồng @company.ShortName (@company.RentMonthsPerPeriod tháng/kỳ), kỳ đang chạy tính từ ngày vào
                                (tháng tròn × @Fmt.Money(form.MonthlyRent) + ngày lẻ ÷ 30). Thu gộp ở trang <a href="@($"hop-dong-cong-ty/{company.Id}")">Hợp đồng công ty</a>.</div>
                            <div>Từ kỳ chốt mồng @settings.BillingDay sau ngày vào: điện (số đã dùng × @Fmt.Money(settings.ElectricityPrice)đ) + nước @Fmt.Money(company.WaterPerRoom)đ/phòng.</div>
                        }
                        else if (stub!.Days > 0)
                        {
                            <div class="mb-1">Tháng trả trước tính cho <strong>@Fmt.Date(stub.To) → @Fmt.Date(stub.To.AddMonths(1))</strong>.</div>
                            <div class="mb-1">Kỳ chốt đầu <strong>@Fmt.Date(stub.To)</strong> thu: tiền phòng @Fmt.Date(stub.From) → @Fmt.Date(stub.To)
                                = <strong>@stub.Days ngày × @Fmt.Money(form.MonthlyRent) ÷ 30 = @Fmt.Vnd(stub.Rent)</strong>
                                + điện (số đã dùng × @Fmt.Money(settings.ElectricityPrice)đ) + nước (@Fmt.Money(settings.WaterPricePerPerson)đ/người, không chia ngày).</div>
                            <div>Từ kỳ <strong>@Fmt.Date(stub.To.AddMonths(1))</strong> thu đủ tháng @Fmt.Vnd(form.MonthlyRent) + điện + nước.</div>
                        }
                        else
                        {
                            <div>Vào đúng ngày chốt: tháng trả trước tính cho <strong>@Fmt.Date(stub.From) → @Fmt.Date(stub.From.AddMonths(1))</strong>.
                                Từ kỳ <strong>@Fmt.Date(stub.From.AddMonths(1))</strong> thu đủ tháng @Fmt.Vnd(form.MonthlyRent) + điện + nước.</div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="nh-card">
                    <h5><i class="fas fa-hand-holding-dollar"></i> Tiền thu khi vào</h5>
                    <table class="nh-table mb-2">
                        @if (company == null)
                        {
                            <tr><td>1 tháng tiền phòng <span class="small text-muted d-block">trả trước · TK hộ kinh doanh</span></td><td class="text-end fw-bold">@Fmt.Money(form.MonthlyRent)</td></tr>
                        }
                        <tr><td>Tiền cọc <span class="small text-muted d-block">TK cá nhân</span></td><td class="text-end">@Fmt.Money(form.Deposit)</td></tr>
                        <tr class="table-light"><td class="fw-bold">@(company == null ? "Khách phải nộp" : $"{company.ShortName} phải nộp")</td><td class="text-end fw-bold fs-5 text-primary">@Fmt.Vnd(total)</td></tr>
                    </table>

                    <div class="form-check form-switch fs-6 mb-2">
                        <input class="form-check-input" type="checkbox" role="switch" id="paidAll" checked="@paidAll" @onchange="e => TogglePaid((bool)e.Value!)" />
                        <label class="form-check-label fw-bold" for="paidAll">@(paidAll ? "Khách đã nộp đủ" : "Khách chưa nộp đủ, nhập số đã thu")</label>
                    </div>
                    @if (!paidAll)
                    {
                        <div class="row g-2 mb-2">
                            <div class="col-6"><label class="form-label">Đã thu cọc</label><MoneyInput @bind-Value="form.DepositPaid" /></div>
                            @if (company == null) { <div class="col-6"><label class="form-label">Đã thu tiền phòng</label><MoneyInput @bind-Value="form.FirstPaymentPaid" /></div> }
                        </div>
                        <div class="small text-muted mb-2">Phần chưa thu sẽ hiện là còn nợ ở phòng.</div>
                    }
                    <details>
                        <summary class="small text-primary">Ngày thu, chứng từ (không bắt buộc)</summary>
                        <div class="mt-2">
                            <label class="form-label">Ngày thu</label>
                            <input type="date" class="form-control mb-2" @bind="form.PaymentDate" />
                            <FileUpload Kind="Receipts" ButtonText="Chứng từ cọc" @bind-Files="form.DepositReceipts" Scanned="r => { if (r.Amount is decimal a) { form.DepositPaid = a; paidAll = false; } if (r.Date is DateTime d) form.PaymentDate = d; }" />
                            <div class="mt-2"><FileUpload Kind="Receipts" ButtonText="Chứng từ tiền phòng" @bind-Files="form.PaymentReceipts" Scanned="r => { if (r.Amount is decimal a) { form.FirstPaymentPaid = a; paidAll = false; } if (r.Date is DateTime d) form.PaymentDate = d; }" /></div>
                        </div>
                    </details>
                </div>
            </div>
        </div>
    }

    <div class="nh-action-bar">
        @if (step > 1)
        {
            <button type="button" class="btn btn-outline-secondary btn-lg flex-grow-0" @onclick="() => Go(step - 1)"><i class="fas fa-chevron-left"></i> Lại</button>
        }
        @if (step < 3)
        {
            <button type="button" class="btn btn-primary btn-lg" disabled="@(room == null)" @onclick="() => Go(step + 1)">
                @(room == null ? "Chọn phòng để tiếp tục" : step == 1 ? "Tiếp: Khách thuê" : "Tiếp: Tiền & xác nhận") <i class="fas fa-chevron-right"></i>
            </button>
        }
        else
        {
            <button type="button" class="btn btn-success btn-lg" disabled="@Busy" @onclick="SaveAsync">
                <i class="fas @(Busy ? "fa-spinner fa-spin" : "fa-check")"></i> Nhận phòng @room!.Code · @Fmt.Vnd(paidAll ? total : form.DepositPaid + form.FirstPaymentPaid)
            </button>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "phong")] public string? RoomCode { get; set; }

    private class FurnitureEdit { public int ItemId; public string Name = ""; public int Quantity; public int Default; }

    private AppSetting? settings;
    private RoomCard? room;
    private RoomDetails? details;
    private List<FurnitureEdit> furniture = [];
    private CheckInForm form = new();
    private bool paidAll = true;
    private int maxPeople = 4;
    private int step = 1;
    private List<CompanyContract> companies = [];
    private CompanyContract? company;

    protected override async Task OnInitializedAsync()
    {
        settings = await Setup.GetSettingsAsync();
        form.Deposit = settings.DefaultDeposit;
        companies = await Companies.ListActiveAsync();
    }

    /// <summary>Chọn bên thuê: khách lẻ hay hợp đồng công ty (giá, cọc, số người theo thời hạn hợp đồng hiện hành).</summary>
    private void OnCompanyChanged(ChangeEventArgs e)
    {
        company = int.TryParse(e.Value?.ToString(), out var id) ? companies.FirstOrDefault(c => c.Id == id) : null;
        form.CompanyContractId = company?.Id;
        if (company != null)
        {
            var term = CompanyService.CurrentTerm(company.Terms, form.MoveInDate);
            if (term != null) { form.MonthlyRent = term.RentPerRoom; form.Deposit = term.DepositPerRoom; }
            maxPeople = company.MaxOccupantsPerRoom;
        }
        else if (details != null)
        {
            form.MonthlyRent = details.Room.Rent;
            form.Deposit = settings!.DefaultDeposit;
            maxPeople = details.Room.MaxOccupants;
        }
    }

    private async Task OnPicked(RoomCard? r)
    {
        room = r;
        details = null;
        furniture = [];
        if (r == null) { form.RoomId = 0; step = 1; return; }
        details = await Rooms.GetDetailsAsync(r.Code);
        if (details == null) { room = null; return; }
        form.RoomId = r.Id;
        form.MonthlyRent = details.Room.Rent;
        form.Deposit = settings!.DefaultDeposit;
        maxPeople = details.Room.MaxOccupants;
        if (company != null) OnCompanyChanged(new ChangeEventArgs { Value = company.Id.ToString() });
        furniture = details.Furniture.Select(f => new FurnitureEdit { ItemId = f.ItemId, Name = f.Name, Quantity = f.Quantity, Default = f.DefaultQuantity }).ToList();
    }

    private void Go(int s)
    {
        if (s >= 2 && room == null) { Toast.Warning("Chọn phòng trước."); step = 1; return; }
        if (s == 3)
        {
            var people = form.Tenants.Where(t => !t.IsEmpty).ToList();
            if (company == null && (people.Count == 0 || people.Any(t => string.IsNullOrWhiteSpace(t.FullName) || string.IsNullOrWhiteSpace(t.IdentityCard))))
            {
                Toast.Warning("Nhập họ tên và số CCCD của người thuê trước.");
                step = 2;
                return;
            }
            if (people.Count > maxPeople) { Toast.Warning($"Phòng tối đa {maxPeople} người."); step = 2; return; }
        }
        step = s;
    }

    private void TogglePaid(bool on)
    {
        paidAll = on;
        if (!on) FillAll();
    }

    private void FillAll()
    {
        form.DepositPaid = form.Deposit;
        form.FirstPaymentPaid = company == null ? form.MonthlyRent : 0;
    }

    private bool RoomConfigChanged => details != null
        && (maxPeople != details.Room.MaxOccupants || furniture.Any(f => f.Quantity != details.Furniture.First(x => x.ItemId == f.ItemId).Quantity));

    private async Task SaveAsync()
    {
        if (paidAll) FillAll();
        int leaseId = 0;
        var user = await GetUserNameAsync();
        var ok = await RunAsync(async () =>
        {
            // Đồ đạc, số người sửa ngay lúc nhận phòng thì lưu vào cấu hình phòng trước (giá phòng CheckInAsync tự cập nhật).
            if (RoomConfigChanged)
                await Rooms.UpdateRoomAsync(room!.Id, form.MonthlyRent, maxPeople, details!.Room.Note, false, furniture.ToDictionary(f => f.ItemId, f => f.Quantity));
            leaseId = await Leases.CheckInAsync(form, user);
        }, "Đã nhận phòng. In hợp đồng cho khách ký rồi tải bản scan lên.");
        if (ok) Nav.NavigateTo($"hop-dong/{leaseId}");
    }
}
