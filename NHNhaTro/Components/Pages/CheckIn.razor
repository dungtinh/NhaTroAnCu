@page "/nhan-phong"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits NhPage
@inject RoomService Rooms
@inject LeaseService Leases
@inject SetupService Setup

<PageTitle>Nhận phòng</PageTitle>

<div class="nh-page-title">
    <h2><i class="fas fa-door-open"></i> Nhận phòng</h2>
</div>

@if (settings == null)
{
    <div class="nh-loading">Đang tải...</div>
}
else
{
    var stub = room == null ? null : LeaseService.CalculateStubPeriod(form.MonthlyRent, form.MoveInDate, settings.BillingDay);
    decimal total = form.MonthlyRent + form.Deposit;

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="nh-card">
                <h5>1. Chọn phòng trống</h5>
                <RoomPicker Mode="RoomPicker.PickMode.Empty" PresetCode="@RoomCode" Picked="OnPicked" />
                @if (room != null)
                {
                    <div class="row g-2 mt-1">
                        <div class="col-6"><label class="form-label">Ngày vào</label><input type="date" class="form-control" @bind="form.MoveInDate" /></div>
                        <div class="col-6"><label class="form-label">Tiền phòng/tháng</label><MoneyInput @bind-Value="form.MonthlyRent" /></div>
                    </div>
                    <details class="mt-2">
                        <summary class="small text-primary">Cọc @Fmt.Vnd(form.Deposit) (mặc định theo cấu hình) · sửa nếu khác</summary>
                        <div class="row g-2 mt-1">
                            <div class="col-6"><label class="form-label">Tiền cọc</label><MoneyInput @bind-Value="form.Deposit" /></div>
                            <div class="col-12"><label class="form-label">Ghi chú</label><input class="form-control" maxlength="1000" @bind="form.Note" /></div>
                        </div>
                    </details>
                }
            </div>

            @if (room != null)
            {
                <div class="nh-card">
                    <h5>2. Khách thuê</h5>
                    <TenantEditor Tenants="form.Tenants" MaxPeople="maxPeople" Compact="true" Changed="StateHasChanged" />
                </div>
            }
        </div>

        <div class="col-lg-4">
            @if (room != null && stub != null)
            {
                <div class="nh-card nh-sticky">
                    <h5>3. Tiền thu khi vào</h5>
                    <table class="nh-table mb-2">
                        <tr><td>1 tháng tiền phòng <span class="small text-muted d-block">trả trước</span></td><td class="text-end fw-bold">@Fmt.Money(form.MonthlyRent)</td></tr>
                        <tr><td>Tiền cọc</td><td class="text-end">@Fmt.Money(form.Deposit)</td></tr>
                        <tr class="table-light"><td class="fw-bold">Khách phải nộp</td><td class="text-end fw-bold fs-5 text-primary">@Fmt.Vnd(total)</td></tr>
                    </table>
                    <div class="small text-muted mb-2">
                        @if (stub.Days > 0)
                        {
                            <div>Tháng trả trước tính cho <strong>@Fmt.Date(stub.To) → @Fmt.Date(stub.To.AddMonths(1))</strong>.</div>
                            <div>Kỳ chốt đầu <strong>@Fmt.Date(stub.To)</strong> thu: tiền phòng @Fmt.Date(stub.From) → @Fmt.Date(stub.To)
                                = <strong>@stub.Days ngày × @Fmt.Money(form.MonthlyRent) ÷ 30 = @Fmt.Vnd(stub.Rent)</strong>
                                + điện (số đã dùng × @Fmt.Money(settings.ElectricityPrice)đ) + nước (@Fmt.Money(settings.WaterPricePerPerson)đ/người, không chia ngày).</div>
                            <div>Từ kỳ <strong>@Fmt.Date(stub.To.AddMonths(1))</strong> thu đủ tháng @Fmt.Vnd(form.MonthlyRent) + điện + nước.</div>
                        }
                        else
                        {
                            <div>Vào đúng ngày chốt: tháng trả trước tính cho <strong>@Fmt.Date(stub.From) → @Fmt.Date(stub.From.AddMonths(1))</strong>.
                                Từ kỳ <strong>@Fmt.Date(stub.From.AddMonths(1))</strong> thu đủ tháng @Fmt.Vnd(form.MonthlyRent) + điện + nước.</div>
                        }
                    </div>

                    <div class="form-check form-switch fs-6 mb-2">
                        <input class="form-check-input" type="checkbox" role="switch" id="paidAll" checked="@paidAll" @onchange="e => TogglePaid((bool)e.Value!)" />
                        <label class="form-check-label fw-bold" for="paidAll">@(paidAll ? "Khách đã nộp đủ" : "Khách chưa nộp đủ, nhập số đã thu")</label>
                    </div>
                    @if (!paidAll)
                    {
                        <div class="row g-2 mb-2">
                            <div class="col-6"><label class="form-label">Đã thu cọc</label><MoneyInput @bind-Value="form.DepositPaid" /></div>
                            <div class="col-6"><label class="form-label">Đã thu tiền phòng</label><MoneyInput @bind-Value="form.FirstPaymentPaid" /></div>
                        </div>
                        <div class="small text-muted mb-2">Phần chưa thu sẽ hiện là còn nợ ở phòng.</div>
                    }
                    <details>
                        <summary class="small text-primary">Ngày thu, chứng từ (không bắt buộc)</summary>
                        <div class="mt-2">
                            <label class="form-label">Ngày thu</label>
                            <input type="date" class="form-control mb-2" @bind="form.PaymentDate" />
                            <FileUpload Kind="Receipts" ButtonText="Chứng từ cọc" @bind-Files="form.DepositReceipts" Scanned="r => { if (r.Amount is decimal a) { form.DepositPaid = a; paidAll = false; } if (r.Date is DateTime d) form.PaymentDate = d; }" />
                            <div class="mt-2"><FileUpload Kind="Receipts" ButtonText="Chứng từ tiền phòng" @bind-Files="form.PaymentReceipts" Scanned="r => { if (r.Amount is decimal a) { form.FirstPaymentPaid = a; paidAll = false; } if (r.Date is DateTime d) form.PaymentDate = d; }" /></div>
                        </div>
                    </details>
                    <button type="button" class="btn btn-success btn-lg w-100 mt-3 d-none d-lg-block" disabled="@Busy" @onclick="SaveAsync">
                        <i class="fas @(Busy ? "fa-spinner fa-spin" : "fa-check")"></i> Nhận phòng
                    </button>
                </div>
            }
            else
            {
                <div class="nh-card text-muted"><i class="fas fa-hand-point-up"></i> Chọn phòng trước, tiền sẽ tự tính theo cấu hình.</div>
            }
        </div>
    </div>
    @if (room != null)
    {
        <div class="nh-action-bar d-lg-none">
            <button type="button" class="btn btn-success btn-lg" disabled="@Busy" @onclick="SaveAsync">
                <i class="fas @(Busy ? "fa-spinner fa-spin" : "fa-check")"></i> Nhận phòng @room.Code · @Fmt.Vnd(paidAll ? total : form.DepositPaid + form.FirstPaymentPaid)
            </button>
        </div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "phong")] public string? RoomCode { get; set; }

    private AppSetting? settings;
    private RoomCard? room;
    private CheckInForm form = new();
    private bool paidAll = true;
    private int maxPeople = 4;

    protected override async Task OnInitializedAsync()
    {
        settings = await Setup.GetSettingsAsync();
        form.Deposit = settings.DefaultDeposit;
    }

    private async Task OnPicked(RoomCard? r)
    {
        room = r;
        if (r == null) { form.RoomId = 0; return; }
        var full = (await Rooms.ListRoomsAsync()).First(x => x.Id == r.Id);
        form.RoomId = r.Id;
        form.MonthlyRent = full.Rent;
        form.Deposit = settings!.DefaultDeposit;
        maxPeople = full.MaxOccupants;
    }

    private void TogglePaid(bool on)
    {
        paidAll = on;
        if (!on) FillAll();
    }

    private void FillAll()
    {
        form.DepositPaid = form.Deposit;
        form.FirstPaymentPaid = form.MonthlyRent;
    }

    private async Task SaveAsync()
    {
        if (paidAll) FillAll();
        int leaseId = 0;
        var user = await GetUserNameAsync();
        if (await RunAsync(async () => leaseId = await Leases.CheckInAsync(form, user), "Đã nhận phòng. In hợp đồng cho khách ký rồi tải bản scan lên."))
            Nav.NavigateTo($"hop-dong/{leaseId}");
    }
}
