@page "/ContractTenants"
@page "/ContractTenants/Index"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits NhPage
@inject TenantService Tenants
@inject ContractService Contracts

<PageTitle>Danh sách người thuê</PageTitle>
<HeadContent><link rel="stylesheet" href="css/legacy/contract-tenants.css" /></HeadContent>

<div class="tenant-report">
    <div class="report-header">
        <h2 class="report-title"><i class="fas fa-users"></i> Danh sách người thuê</h2>
        @if (rows != null)
        {
            <div class="report-stats">
                <div class="stat-item"><span class="stat-value">@rows.Count</span><span class="stat-label">Người thuê</span></div>
                <div class="stat-item"><span class="stat-value">@rows.Select(r => r.RoomId).Distinct().Count()</span><span class="stat-label">Phòng</span></div>
                <div class="stat-item"><span class="stat-value">@rows.Where(r => r.CompanyId.HasValue).Select(r => r.CompanyId).Distinct().Count()</span><span class="stat-label">Công ty</span></div>
                <div class="stat-item"><span class="stat-value">@rows.Count(r => Nationality.IsForeign(r.Ethnicity))</span><span class="stat-label">Nước ngoài</span></div>
            </div>
        }
    </div>

    <div class="filter-section">
        <div class="filter-row">
            <div class="filter-group"><label>Tìm theo tên</label><input class="form-control" @bind="filter.SearchName" @onkeyup="OnKey" /></div>
            <div class="filter-group"><label>Tìm theo CCCD</label><input class="form-control" @bind="filter.SearchCard" @onkeyup="OnKey" /></div>
            <div class="filter-group"><label>Tìm theo phòng</label><input class="form-control" @bind="filter.SearchRoom" @onkeyup="OnKey" /></div>
        </div>
        <div class="filter-row">
            <div class="filter-group">
                <label>Loại hợp đồng</label>
                <select class="form-control" @bind="filter.ContractType">
                    <option value="">-- Tất cả --</option>
                    <option value="@ContractType.Individual">Cá nhân/Hộ gia đình</option>
                    <option value="@ContractType.Company">Công ty</option>
                </select>
            </div>
            <div class="filter-group">
                <label>Công ty</label>
                <select class="form-control" @bind="filter.CompanyId">
                    <option value="">-- Tất cả --</option>
                    @foreach (var c in companies)
                    {
                        <option value="@c.Id">@c.CompanyName</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>Trạng thái</label>
                <select class="form-control" @bind="filter.Status">
                    <option value="">Đang ở (mặc định)</option>
                    <option value="@ContractStatus.Expired">Hết hạn</option>
                    <option value="@ContractStatus.Ended">Đã kết thúc</option>
                </select>
            </div>
        </div>
        <div class="action-buttons">
            <button type="button" class="btn btn-search btn-primary" @onclick="LoadAsync"><i class="fas fa-search"></i> Tìm kiếm</button>
            <button type="button" class="btn btn-reset btn-secondary" @onclick="ResetAsync"><i class="fas fa-redo"></i> Đặt lại</button>
            <a class="btn btn-export btn-export-excel btn-success" href="@ExportUrl("files/tenants.xlsx")" target="_blank"><i class="fas fa-file-excel"></i> Sổ lưu trú (Excel)</a>
            <a class="btn btn-export btn-export-pdf btn-danger" href="@ExportUrl("files/tenants.pdf")" target="_blank"><i class="fas fa-file-pdf"></i> Xuất PDF</a>
        </div>
    </div>

    @if (rows == null)
    {
        <div class="nh-loading"><i class="fas fa-spinner fa-spin fa-2x"></i></div>
    }
    else if (rows.Count == 0)
    {
        <div class="no-data"><i class="fas fa-user-slash fa-3x"></i><p>Không có người thuê nào phù hợp.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table report-table">
                <thead>
                    <tr>
                        <th width="100">Ảnh</th>
                        <th>Họ tên</th>
                        <th>CCCD</th>
                        <th>Điện thoại</th>
                        <th>Ngày sinh</th>
                        <th>Giới tính</th>
                        <th>Phòng</th>
                        <th>Loại HĐ</th>
                        <th>Công ty</th>
                        <th>Trạng thái</th>
                        <th>Ngày vào</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        <tr class="@(r.IsPrimary ? "primary-tenant" : "")" @key="r.ContractTenantId">
                            <td>
                                @if (r.FirstPhoto is { } photo)
                                {
                                    <a href="@photo" target="_blank"><img src="@photo" class="tenant-photo photo-thumb" alt="" /></a>
                                }
                                else
                                {
                                    <span class="no-photo"><i class="fas fa-user"></i></span>
                                }
                            </td>
                            <td><strong>@r.TenantName</strong> @if (r.IsPrimary) {<i class="fas fa-star text-warning" title="Người đại diện"></i>}</td>
                            <td>@r.IdentityCard</td>
                            <td>@r.PhoneNumber</td>
                            <td>@Fmt.Date(r.BirthDate)</td>
                            <td>@r.Gender</td>
                            <td><a href="@($"Rooms/Details/{r.RoomId}")" class="room-badge">@r.RoomName</a></td>
                            <td><span class="contract-type-badge">@ContractType.Display(r.ContractType)</span></td>
                            <td class="company-name">@(r.CompanyName ?? "-")</td>
                            <td>
                                <span class="status-badge @(r.ContractStatus switch { ContractStatus.Active => "status-active", ContractStatus.Expired => "status-expired", _ => "status-terminated" })">
                                    @PdfDocuments.TenantStatusText(r.ContractStatus)
                                </span>
                            </td>
                            <td>@Fmt.Date(r.MoveInDate)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private TenantFilter filter = new();
    private List<TenantRow>? rows;
    private List<Company> companies = [];

    protected override async Task OnInitializedAsync()
    {
        companies = await Contracts.ListCompaniesAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => rows = await Tenants.ListAsync(filter);

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task ResetAsync()
    {
        filter = new TenantFilter();
        await LoadAsync();
    }

    private string ExportUrl(string path) => Nav.GetUriWithQueryParameters(Nav.BaseUri + path, new Dictionary<string, object?>
    {
        ["searchName"] = filter.SearchName,
        ["searchCard"] = filter.SearchCard,
        ["searchRoom"] = filter.SearchRoom,
        ["status"] = filter.Status,
        ["companyId"] = filter.CompanyId,
        ["contractType"] = filter.ContractType
    });
}
