@page "/ContractTenants/TenantManager"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits NhPage
@inject TenantService Tenants
@inject FileStorage Storage

<PageTitle>Quản lý người thuê</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="css/legacy/contract-action.css" />
    <link rel="stylesheet" href="css/legacy/tenant-manager-inline.css" />
</HeadContent>

<div class="contract-form-container">
    <div class="form-header">
        <h3><i class="fas fa-users-cog"></i> Quản lý người thuê</h3>
        @if (m != null)
        {
            <p class="mb-0">
                <span class="badge bg-light text-dark me-2"><i class="fas fa-file-contract"></i> @m.ContractCode</span>
                <span class="badge bg-light text-dark me-2"><i class="fas fa-door-open"></i> Phòng @m.RoomName</span>
                <span class="badge bg-light text-dark"><i class="fas fa-building"></i> @m.CompanyName</span>
            </p>
        }
    </div>

    @if (m == null)
    {
        <div class="nh-loading">@(notFound ? "Không tìm thấy hợp đồng hoặc phòng không thuộc hợp đồng này." : "Đang tải...")</div>
    }
    else
    {
        @if (!scanConfigured)
        {
            <div class="alert alert-secondary small">
                <i class="fas fa-info-circle"></i> Chưa cấu hình API key FPT.AI (bảng FPTReaderAPI) nên chưa quét CCCD tự động được. Ảnh CCCD vẫn tải lên và lưu bình thường.
            </div>
        }

        @for (int i = 0; i < m.Tenants.Count; i++)
        {
            var index = i;
            var t = m.Tenants[index];
            <div class="tenant-card-form tenant-card" @key="t">
                <div class="tenant-card-title">
                    <h5 style="color: #2c3e50; margin: 0;">
                        <i class="fas fa-user"></i> Người thuê @(index + 1) @(index == 0 ? "(đại diện)" : "")
                    </h5>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Remove(index)"><i class="fas fa-trash"></i> Gỡ</button>
                </div>

                <div class="mb-3">
                    <label class="form-label">Upload ảnh CCCD/CMND @(scanConfigured ? "để tự động điền thông tin" : "")</label>
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        <InputFile class="form-control" style="max-width: 380px" accept="image/*" multiple OnChange="e => OnPhotosSelected(index, e)" />
                        @if (scanConfigured && t.Photos.Count > 0)
                        {
                            <button type="button" class="btn btn-info btn-sm" disabled="@(scanning == index)" @onclick="() => ScanAsync(index)">
                                <i class="fas @(scanning == index ? "fa-spinner fa-spin" : "fa-magic")"></i> Quét CCCD
                            </button>
                        }
                    </div>
                    @if (t.Photos.Count > 0)
                    {
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            @foreach (var photo in t.Photos)
                            {
                                <div class="position-relative">
                                    <a href="@photo" target="_blank"><img src="@photo" class="photo-thumb" alt="CCCD" /></a>
                                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 py-0 px-1" title="Bỏ ảnh" @onclick="() => RemovePhoto(t, photo)">×</button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label>Họ và tên <span class="text-danger">*</span></label>
                        <input class="form-control tenant-name" maxlength="100" @bind="t.FullName" />
                    </div>
                    <div class="col-md-6">
                        <label>Số CCCD/CMND <span class="text-danger">*</span></label>
                        <input class="form-control tenant-identity" maxlength="20" @bind="t.IdentityCard" @bind:after="() => LookupAsync(t)" />
                    </div>
                    <div class="col-md-4">
                        <label>Số điện thoại</label>
                        <input class="form-control" maxlength="20" @bind="t.PhoneNumber" />
                    </div>
                    <div class="col-md-4">
                        <label>Ngày sinh</label>
                        <input type="date" class="form-control" @bind="t.BirthDate" />
                    </div>
                    <div class="col-md-4">
                        <label>Giới tính</label>
                        <select class="form-control" @bind="t.Gender">
                            <option value="">-- Chọn --</option>
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label>Dân tộc / Quốc tịch</label>
                        <input class="form-control" maxlength="50" list="ethnicity-list" @bind="t.Ethnicity" placeholder="Kinh" />
                    </div>
                    <div class="col-md-4">
                        <label>Biển số xe</label>
                        <input class="form-control" maxlength="20" @bind="t.VehiclePlate" />
                    </div>
                    <div class="col-md-12">
                        <label>Địa chỉ thường trú</label>
                        <input class="form-control" maxlength="255" @bind="t.PermanentAddress" />
                    </div>
                </div>
            </div>
        }

        <datalist id="ethnicity-list">
            <option value="Kinh"></option>
            <option value="Tày"></option>
            <option value="Mường"></option>
            <option value="Trung Quốc"></option>
            <option value="Lào"></option>
            <option value="Campuchia"></option>
            <option value="Thái Lan"></option>
        </datalist>

        <div class="text-center mb-3">
            <button type="button" class="btn btn-add-tenant btn-outline-success" @onclick="Add"><i class="fas fa-user-plus"></i> Thêm người thuê</button>
        </div>

        <div class="text-center mb-4">
            <button type="button" class="btn-submit btn btn-primary btn-lg" disabled="@Busy" @onclick="SaveAsync"><i class="fas @(Busy ? "fa-spinner fa-spin" : "fa-save")"></i> Lưu thông tin</button>
            <a href="@($"Rooms/Details/{RoomId}")" class="btn btn-secondary btn-lg" style="margin-left: 10px;"><i class="fas fa-door-open"></i> Về phòng</a>
            <a href="@($"Contracts/Details/{ContractId}")" class="btn btn-outline-secondary btn-lg" style="margin-left: 10px;"><i class="fas fa-file-contract"></i> Về hợp đồng</a>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery] public int ContractId { get; set; }
    [SupplyParameterFromQuery] public int RoomId { get; set; }

    private TenantManagerModel? m;
    private bool notFound;
    private bool scanConfigured;
    private int? scanning;
    private readonly List<string> uploadedThisSession = [];

    protected override async Task OnInitializedAsync()
    {
        m = await Tenants.GetManagerAsync(ContractId, RoomId);
        notFound = m == null;
        if (m != null && m.Tenants.Count == 0) m.Tenants.Add(new TenantInput());
        scanConfigured = await Tenants.IsCardScanConfiguredAsync();
    }

    private void Add() => m!.Tenants.Add(new TenantInput());

    private void Remove(int index)
    {
        m!.Tenants.RemoveAt(index);
        if (m.Tenants.Count == 0) m.Tenants.Add(new TenantInput());
    }

    private void RemovePhoto(TenantInput t, string photo)
    {
        t.Photos.Remove(photo);
        if (uploadedThisSession.Remove(photo)) Storage.Delete(photo);
    }

    private async Task OnPhotosSelected(int index, InputFileChangeEventArgs e)
    {
        var t = m!.Tenants[index];
        foreach (var file in e.GetMultipleFiles(10))
        {
            if (file.Size > FileStorage.MaxImageSize)
            {
                Toast.Error($"Ảnh {file.Name} vượt quá 5MB.");
                continue;
            }
            await RunAsync(async () =>
            {
                await using var stream = file.OpenReadStream(FileStorage.MaxImageSize);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                buffer.Position = 0;
                var path = await Storage.SaveTenantPhotoAsync(buffer, file.Name, t.IdentityCard);
                t.Photos.Add(path);
                uploadedThisSession.Add(path);
            });
        }
        if (scanConfigured && string.IsNullOrWhiteSpace(t.FullName) && t.Photos.Count > 0)
            await ScanAsync(index);
    }

    /// <summary>Gửi ảnh CCCD đầu tiên vừa tải lên tới FPT.AI và điền vào các ô còn trống.</summary>
    private async Task ScanAsync(int index)
    {
        var t = m!.Tenants[index];
        var photo = t.Photos.LastOrDefault(p => uploadedThisSession.Contains(p)) ?? t.Photos.FirstOrDefault();
        var physical = Storage.ResolvePhysicalPath(photo);
        if (physical == null || !File.Exists(physical))
        {
            Toast.Warning("Không tìm thấy ảnh để quét.");
            return;
        }

        scanning = index;
        try
        {
            CardScanResult r;
            await using (var fs = File.OpenRead(physical))
            {
                r = await Tenants.ScanIdentityCardAsync(fs, Path.GetFileName(physical), MimeOf(physical));
            }
            if (!string.IsNullOrEmpty(r.Name)) t.FullName = r.Name;
            if (!string.IsNullOrEmpty(r.Id)) t.IdentityCard = r.Id;
            if (r.BirthDate.HasValue) t.BirthDate = r.BirthDate;
            if (!string.IsNullOrEmpty(r.Gender)) t.Gender = r.Gender;
            if (!string.IsNullOrEmpty(r.Address)) t.PermanentAddress = r.Address;
            if (!string.IsNullOrEmpty(r.Ethnicity)) t.Ethnicity = r.Ethnicity;
            Toast.Success("Quét CCCD thành công.");
        }
        catch (InvalidOperationException ex)
        {
            Toast.Error(ex.Message);
        }
        catch (HttpRequestException ex)
        {
            Toast.Error("Lỗi kết nối FPT.AI: " + ex.Message);
        }
        finally
        {
            scanning = null;
        }
    }

    private static string MimeOf(string path) => Path.GetExtension(path).ToLowerInvariant() switch
    {
        ".png" => "image/png",
        ".gif" => "image/gif",
        ".bmp" => "image/bmp",
        ".webp" => "image/webp",
        _ => "image/jpeg"
    };

    /// <summary>Nhập số CCCD của người đã từng thuê thì điền lại thông tin cũ.</summary>
    private async Task LookupAsync(TenantInput t)
    {
        if (string.IsNullOrWhiteSpace(t.IdentityCard) || !string.IsNullOrWhiteSpace(t.FullName)) return;
        var existing = await Tenants.FindByIdentityCardAsync(t.IdentityCard);
        if (existing == null) return;
        t.TenantId = existing.TenantId;
        t.FullName = existing.FullName;
        t.PhoneNumber ??= existing.PhoneNumber;
        t.BirthDate ??= existing.BirthDate;
        t.Gender ??= existing.Gender;
        t.PermanentAddress ??= existing.PermanentAddress;
        t.Ethnicity ??= existing.Ethnicity;
        t.VehiclePlate ??= existing.VehiclePlate;
        foreach (var p in existing.Photos.Where(p => !t.Photos.Contains(p))) t.Photos.Add(p);
        Toast.Info($"Đã điền thông tin người thuê cũ: {existing.FullName}.");
    }

    private async Task SaveAsync()
    {
        if (m == null) return;
        if (m.Tenants.All(t => t.IsEmpty) && !await ConfirmAsync("Không có người thuê nào. Lưu sẽ gỡ toàn bộ người thuê khỏi phòng này. Tiếp tục?")) return;
        if (await RunAsync(() => Tenants.SaveManagerAsync(ContractId, RoomId, m.Tenants), "Đã cập nhật thông tin người thuê thành công!"))
        {
            uploadedThisSession.Clear();
            Nav.NavigateTo($"Rooms/Details/{RoomId}");
        }
    }
}
