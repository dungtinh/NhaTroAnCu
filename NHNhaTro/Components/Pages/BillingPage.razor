@page "/thu-tien"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits NhPage
@inject BillingService Billing
@inject SetupService Setup

<PageTitle>Thu tiền tháng</PageTitle>

<div class="nh-page-title">
    <h2><i class="fas fa-file-invoice-dollar"></i> Thu tiền tháng</h2>
    <div class="nh-month">
        <button type="button" class="btn" title="Tháng trước" @onclick="() => ShiftAsync(-1)"><i class="fas fa-chevron-left"></i></button>
        <input type="month" class="form-control" value="@($"{year:0000}-{month:00}")" @onchange="OnMonthChanged" />
        <button type="button" class="btn" title="Tháng sau" @onclick="() => ShiftAsync(1)"><i class="fas fa-chevron-right"></i></button>
    </div>
</div>

@if (sheet == null)
{
    <div class="nh-bills">
        @for (int i = 0; i < 4; i++) { <div class="nh-bill nh-skeleton"></div> }
    </div>
}
else
{
    decimal ep = sheet.ElectricityPrice, wp = sheet.WaterPerPerson;
    // Chưa thu xếp trước, đã thu xếp sau; trong mỗi nhóm theo dãy A → B, tầng thấp → cao, số phòng bé → to.
    var rows = sheet.Rows.Where(r => showAll || !r.SkipThisMonth).OrderBy(r => r.BlockCode).ThenBy(r => r.Floor).ThenBy(r => r.Number).ToList();
    var pending = rows.Where(r => !r.IsPaid(ep, wp)).ToList();
    var done = rows.Where(r => r.IsPaid(ep, wp)).ToList();
    decimal total = rows.Where(r => r.BillId != null).Sum(r => r.Total(ep, wp));
    decimal paid = rows.Sum(r => r.Paid);
    int needed = rows.Count(r => !r.SkipThisMonth);

    <div class="nh-stats">
        <div class="nh-stat accent-blue"><div class="v">@done.Count<span class="of">/@needed</span></div><div class="l">Phòng đã thu</div></div>
        <div class="nh-stat"><div class="v">@Fmt.Money(total)</div><div class="l">Tổng phải thu</div></div>
        <div class="nh-stat accent-green"><div class="v">@Fmt.Money(paid)</div><div class="l">Đã thu</div></div>
        <div class="nh-stat accent-red"><div class="v">@Fmt.Money(Math.Max(0, total - paid))</div><div class="l">Còn lại</div></div>
    </div>

    <div class="nh-toolbar">
        <div class="hint">
            <i class="fas fa-bolt"></i> Kỳ chốt <strong>@Fmt.Date(sheet.DueDate)</strong> · điện @Fmt.Money(ep)đ/số · nước @Fmt.Money(wp)đ/người.
            Chỉ cần ghi số điện đã dùng, tiền tự tính.
        </div>
        <div class="tools">
            <label class="nh-switch">
                <input type="checkbox" @bind="showAll" /><span></span>
                <small>Hiện cả phòng mới vào tháng này</small>
            </label>
            @if (pending.Any(r => r.Kwh != null && r.BillId == null && !r.SkipThisMonth))
            {
                <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="SaveAllAsync"><i class="fas fa-save"></i> Lưu tất cả phiếu đã ghi số điện</button>
            }
        </div>
    </div>

    <div class="nh-bills">
        @if (rows.Count == 0)
        {
            <div class="nh-empty"><i class="fas fa-mug-hot"></i><div>Không có phòng nào cần thu tiền tháng này.</div></div>
        }

        @if (pending.Count > 0)
        {
            <h6 class="nh-group"><span class="dot red"></span> Chưa thu <span class="n">@pending.Count</span></h6>
            @foreach (var r in pending) { @Card(r, ep, wp) }
        }
        @if (done.Count > 0)
        {
            <h6 class="nh-group"><span class="dot green"></span> Đã thu <span class="n">@done.Count</span></h6>
            @foreach (var r in done) { @Card(r, ep, wp) }
        }
    </div>

    <PaymentDialog Bill="payBill" Paid="payPaid" RoomCode="@payRoom" Closed="() => payBill = null" Saved="AfterPayAsync" />
}

@code {
    private int month, year;
    private BillingSheet? sheet;
    private bool showAll;
    private Bill? payBill;
    private decimal payPaid;
    private string payRoom = "";

    /// <summary>Một phòng trên danh sách thu tiền. Cùng một thẻ cho điện thoại và máy tính: CSS container query tự xếp thành hàng khi rộng.</summary>
    private RenderFragment Card(BillingRow r, decimal ep, decimal wp) => __builder =>
    {
        var t = r.Total(ep, wp);
        bool isDone = r.IsPaid(ep, wp);
        decimal other = r.OtherAmount - r.Discount;
        string state = isDone ? "done" : r.BillId != null ? "unpaid" : r.SkipThisMonth ? "skip" : "new";
        <article class="nh-bill @state" @key="r.LeaseId">
            <header class="head">
                <a href="@($"phong/{r.RoomCode}")" class="room">@r.RoomCode</a>
                <div class="who">
                    <div class="name">@r.Representative</div>
                    <div class="period">
                        @if (r.SkipThisMonth) { <span>Đã thu 1 tháng khi vào</span> }
                        else if (r.IsFirstMonth) { <span>Kỳ đầu @Fmt.Date(r.PeriodFrom) → @Fmt.Date(r.PeriodTo)</span> }
                        else { <span>Kỳ @Fmt.Date(r.PeriodFrom) → @Fmt.Date(r.PeriodTo)</span> }
                        @if (r.PreviousDebt > 0) { <span class="debt"><i class="fas fa-exclamation-circle"></i> nợ cũ @Fmt.Vnd(r.PreviousDebt)</span> }
                    </div>
                </div>
                <div class="amount">
                    <div class="sum">@Fmt.Vnd(t)</div>
                    @if (isDone) { <span class="pill pill-done"><i class="fas fa-check"></i> Đã thu</span> }
                    else if (r.BillId != null) { <span class="pill pill-unpaid">Chưa thu@(r.Paid > 0 ? $" · còn {Fmt.Money(t - r.Paid)}" : "")</span> }
                    else if (r.SkipThisMonth) { <span class="pill pill-skip">Không cần lập</span> }
                    else { <span class="pill pill-new">Chưa lập phiếu</span> }
                </div>
            </header>

            <div class="inputs">
                <label class="nh-field kwh">
                    <span>Số điện đã dùng <small>kWh</small></span>
                    <input type="number" inputmode="numeric" min="0" placeholder="0" class="form-control nh-meter @(r.Kwh < 0 ? "is-invalid" : "")" @bind="r.Kwh" disabled="@isDone" />
                </label>
                <label class="nh-field ppl">
                    <span>Người</span>
                    <input type="number" inputmode="numeric" min="0" class="form-control" @bind="r.PersonCount" disabled="@isDone" />
                </label>
            </div>

            <ul class="breakdown">
                <li><span>Phòng</span><b>@Fmt.Money(r.Rent)</b></li>
                <li><span>Điện@(r.Kwh > 0 ? $" · {r.Kwh} số" : "")</span><b>@Fmt.Money(r.Electricity(ep))</b></li>
                <li><span>Nước · @r.PersonCount người</span><b>@Fmt.Money(r.Water(wp))</b></li>
                @if (other != 0) { <li><span>Khác</span><b>@Fmt.Money(other)</b></li> }
            </ul>

            <footer class="actions">
                @if (!isDone)
                {
                    <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="() => SaveRowAsync(r)">
                        <i class="fas @(r.BillId == null ? "fa-file-circle-plus" : "fa-save")"></i> @(r.BillId == null ? "Lập phiếu" : "Lưu")
                    </button>
                    @if (r.BillId != null)
                    {
                        <button type="button" class="btn btn-success" @onclick="() => OpenPayAsync(r)"><i class="fas fa-hand-holding-dollar"></i> Thu tiền</button>
                    }
                }
                @if (r.BillId != null)
                {
                    <a class="btn btn-outline-secondary" title="In phiếu thu" href="@($"files/bills/{r.BillId}")" target="_blank"><i class="fas fa-print"></i> <span>In phiếu</span></a>
                }
                @if (!isDone)
                {
                    <details class="more">
                        <summary title="Sửa tiền phòng, ghi chú"><i class="fas fa-ellipsis"></i></summary>
                        <div class="more-body">
                            <label class="nh-field"><span>Tiền phòng kỳ này</span><MoneyInput @bind-Value="r.Rent" /></label>
                            <label class="nh-field"><span>Ghi chú</span><input class="form-control" maxlength="200" @bind="r.Note" /></label>
                        </div>
                    </details>
                }
            </footer>
        </article>
    };

    protected override async Task OnInitializedAsync()
    {
        var s = await Setup.GetSettingsAsync();
        (month, year) = RoomService.CurrentBillingPeriod(s.BillingDay);
        await LoadAsync();
    }

    private async Task LoadAsync() => sheet = await Billing.GetSheetAsync(month, year);

    private async Task ShiftAsync(int delta)
    {
        var d = new DateTime(year, month, 1).AddMonths(delta);
        (month, year) = (d.Month, d.Year);
        sheet = null;
        await LoadAsync();
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParseExact(e.Value?.ToString(), "yyyy-MM", null, System.Globalization.DateTimeStyles.None, out var d))
        {
            (month, year) = (d.Month, d.Year);
            sheet = null;
            await LoadAsync();
        }
    }

    private async Task SaveRowAsync(BillingRow r)
    {
        var user = await GetUserNameAsync();
        if (await RunAsync(async () => r.BillId = await Billing.SaveBillAsync(month, year, r, user), $"Đã lưu phiếu phòng {r.RoomCode}.")) await LoadAsync();
    }

    private async Task SaveAllAsync()
    {
        var user = await GetUserNameAsync();
        var todo = sheet!.Rows.Where(r => r.Kwh != null && (!r.SkipThisMonth || r.BillId != null) && !r.IsPaid(sheet.ElectricityPrice, sheet.WaterPerPerson)).ToList();
        if (todo.Count == 0) { Toast.Error("Chưa ghi số điện đã dùng cho phòng nào."); return; }
        int ok = 0;
        var errors = new List<string>();
        Busy = true;
        try
        {
            foreach (var r in todo)
            {
                try { await Billing.SaveBillAsync(month, year, r, user); ok++; }
                catch (InvalidOperationException ex) { errors.Add(ex.Message); }
            }
        }
        finally { Busy = false; }
        if (ok > 0) Toast.Success($"Đã lưu {ok} phiếu.");
        foreach (var e in errors) Toast.Error(e);
        await LoadAsync();
    }

    private async Task OpenPayAsync(BillingRow r)
    {
        payBill = await Billing.GetBillAsync(r.BillId!.Value);
        payPaid = r.Paid;
        payRoom = r.RoomCode;
    }

    private async Task AfterPayAsync()
    {
        payBill = null;
        await LoadAsync();
    }
}
