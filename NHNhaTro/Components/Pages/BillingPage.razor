@page "/thu-tien"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits NhPage
@inject BillingService Billing
@inject SetupService Setup

<PageTitle>Thu tiền tháng</PageTitle>

<div class="nh-page-title">
    <h2><i class="fas fa-file-invoice-dollar"></i> Thu tiền tháng</h2>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <button type="button" class="btn btn-outline-secondary" @onclick="() => ShiftAsync(-1)"><i class="fas fa-chevron-left"></i></button>
        <input type="month" class="form-control" style="width: 170px" value="@($"{year:0000}-{month:00}")" @onchange="OnMonthChanged" />
        <button type="button" class="btn btn-outline-secondary" @onclick="() => ShiftAsync(1)"><i class="fas fa-chevron-right"></i></button>
    </div>
</div>

@if (sheet == null)
{
    <div class="nh-loading"><i class="fas fa-spinner fa-spin fa-2x"></i></div>
}
else
{
    var rows = sheet.Rows.Where(r => showAll || !r.SkipThisMonth).ToList();
    decimal total = rows.Where(r => r.BillId != null).Sum(r => r.Total(sheet.ElectricityPrice, sheet.WaterPerPerson));
    decimal paid = rows.Sum(r => r.Paid);
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-3"><div class="nh-stat"><div class="v">@rows.Count(r => r.BillId != null)/@rows.Count(r => !r.SkipThisMonth)</div><div class="l">Phiếu đã lập</div></div></div>
        <div class="col-6 col-md-3"><div class="nh-stat"><div class="v">@Fmt.Money(total)</div><div class="l">Tổng phải thu</div></div></div>
        <div class="col-6 col-md-3"><div class="nh-stat"><div class="v text-success">@Fmt.Money(paid)</div><div class="l">Đã thu</div></div></div>
        <div class="col-6 col-md-3"><div class="nh-stat"><div class="v text-danger">@Fmt.Money(Math.Max(0, total - paid))</div><div class="l">Còn lại</div></div></div>
    </div>

    <div class="nh-card">
        <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
            <div class="small text-muted">
                Kỳ thu ngày @Fmt.Date(sheet.DueDate). Điện @Fmt.Money(sheet.ElectricityPrice)đ/số, nước @Fmt.Money(sheet.WaterPerPerson)đ/người.
                Phòng mới vào trong tháng trước đã thu kỳ đầu nên không cần lập phiếu.
            </div>
            <div class="d-flex gap-2 align-items-center">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="showAll" @bind="showAll" />
                    <label class="form-check-label small" for="showAll">Hiện cả phòng không cần lập</label>
                </div>
                <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="SaveAllAsync"><i class="fas fa-save"></i> Lưu tất cả phiếu đã nhập số điện</button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="nh-table nh-billing">
                <thead>
                    <tr>
                        <th>Phòng</th><th>Người thuê</th><th style="width:110px">Tiền phòng</th><th>Số cũ</th><th style="width:100px">Số mới</th><th class="text-end">Điện</th>
                        <th style="width:70px">Người</th><th class="text-end">Nước</th><th style="width:110px">Khác</th><th style="width:110px">Giảm</th>
                        <th class="text-end">Tổng</th><th class="text-end">Đã thu</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        var t = r.Total(sheet.ElectricityPrice, sheet.WaterPerPerson);
                        <tr @key="r.LeaseId" class="@(r.SkipThisMonth ? "text-muted" : "") @(r.BillId != null && r.Paid >= t ? "table-success" : "")">
                            <td><a href="@($"phong/{r.RoomCode}")" class="fw-bold">@r.RoomCode</a></td>
                            <td>@r.Representative
                                @if (r.PreviousDebt > 0) { <div class="small text-danger">Nợ cũ @Fmt.Money(r.PreviousDebt)</div> }
                                @if (r.SkipThisMonth) { <div class="small">Đã thu kỳ đầu</div> }
                            </td>
                            <td><MoneyInput @bind-Value="r.Rent" CssClass="form-control form-control-sm money" /></td>
                            <td>@r.MeterStart</td>
                            <td><input type="number" min="@r.MeterStart" class="form-control form-control-sm @(r.MeterEnd < r.MeterStart ? "is-invalid" : "")" @bind="r.MeterEnd" /></td>
                            <td class="text-end">@Fmt.Money(r.Electricity(sheet.ElectricityPrice))</td>
                            <td><input type="number" min="0" class="form-control form-control-sm" @bind="r.PersonCount" /></td>
                            <td class="text-end">@Fmt.Money(r.Water(sheet.WaterPerPerson))</td>
                            <td><MoneyInput @bind-Value="r.OtherAmount" CssClass="form-control form-control-sm money" /></td>
                            <td><MoneyInput @bind-Value="r.Discount" CssClass="form-control form-control-sm money" /></td>
                            <td class="text-end fw-bold">@Fmt.Money(t)</td>
                            <td class="text-end @(r.Paid >= t && r.BillId != null ? "text-success" : "")">@Fmt.Money(r.Paid)</td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-sm btn-primary" title="Lưu phiếu" disabled="@Busy" @onclick="() => SaveRowAsync(r)"><i class="fas fa-save"></i></button>
                                @if (r.BillId != null)
                                {
                                    @if (r.Paid < t) { <button type="button" class="btn btn-sm btn-success" title="Thu tiền" @onclick="() => OpenPayAsync(r)"><i class="fas fa-hand-holding-usd"></i></button> }
                                    <a class="btn btn-sm btn-outline-secondary" title="In phiếu" href="@($"files/bills/{r.BillId}")" target="_blank"><i class="fas fa-print"></i></a>
                                }
                            </td>
                        </tr>
                    }
                    @if (rows.Count == 0) { <tr><td colspan="13" class="text-center text-muted py-3">Không có phòng nào cần lập phiếu tháng này.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>

    <PaymentDialog Bill="payBill" Paid="payPaid" RoomCode="@payRoom" Closed="() => payBill = null" Saved="AfterPayAsync" />
}

@code {
    private int month, year;
    private BillingSheet? sheet;
    private bool showAll;
    private Bill? payBill;
    private decimal payPaid;
    private string payRoom = "";

    protected override async Task OnInitializedAsync()
    {
        var s = await Setup.GetSettingsAsync();
        (month, year) = RoomService.CurrentBillingPeriod(s.BillingDay);
        await LoadAsync();
    }

    private async Task LoadAsync() => sheet = await Billing.GetSheetAsync(month, year);

    private async Task ShiftAsync(int delta)
    {
        var d = new DateTime(year, month, 1).AddMonths(delta);
        (month, year) = (d.Month, d.Year);
        await LoadAsync();
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParseExact(e.Value?.ToString(), "yyyy-MM", null, System.Globalization.DateTimeStyles.None, out var d))
        {
            (month, year) = (d.Month, d.Year);
            await LoadAsync();
        }
    }

    private async Task SaveRowAsync(BillingRow r)
    {
        var user = await GetUserNameAsync();
        if (await RunAsync(async () => r.BillId = await Billing.SaveBillAsync(month, year, r, user), $"Đã lưu phiếu phòng {r.RoomCode}.")) await LoadAsync();
    }

    private async Task SaveAllAsync()
    {
        var user = await GetUserNameAsync();
        var todo = sheet!.Rows.Where(r => r.MeterEnd != null && (!r.SkipThisMonth || r.BillId != null)).ToList();
        if (todo.Count == 0) { Toast.Error("Chưa nhập số điện mới cho phòng nào."); return; }
        int ok = 0;
        var errors = new List<string>();
        Busy = true;
        try
        {
            foreach (var r in todo)
            {
                try { await Billing.SaveBillAsync(month, year, r, user); ok++; }
                catch (InvalidOperationException ex) { errors.Add(ex.Message); }
            }
        }
        finally { Busy = false; }
        if (ok > 0) Toast.Success($"Đã lưu {ok} phiếu.");
        foreach (var e in errors) Toast.Error(e);
        await LoadAsync();
    }

    private async Task OpenPayAsync(BillingRow r)
    {
        payBill = await Billing.GetBillAsync(r.BillId!.Value);
        payPaid = r.Paid;
        payRoom = r.RoomCode;
    }

    private async Task AfterPayAsync()
    {
        payBill = null;
        await LoadAsync();
    }
}
