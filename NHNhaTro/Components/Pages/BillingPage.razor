@page "/thu-tien"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits NhPage
@inject BillingService Billing
@inject SetupService Setup

<PageTitle>Thu tiền tháng</PageTitle>

<div class="nh-page-title">
    <h2><i class="fas fa-file-invoice-dollar"></i> Thu tiền tháng</h2>
    <div class="d-flex gap-2 align-items-center">
        <a class="btn btn-warning" href="so-dien"><i class="fas fa-bolt"></i> Ghi số điện</a>
        <div class="nh-month">
            <button type="button" class="btn" title="Tháng trước" @onclick="() => ShiftAsync(-1)"><i class="fas fa-chevron-left"></i></button>
            <input type="month" class="form-control" value="@($"{year:0000}-{month:00}")" @onchange="OnMonthChanged" />
            <button type="button" class="btn" title="Tháng sau" @onclick="() => ShiftAsync(1)"><i class="fas fa-chevron-right"></i></button>
        </div>
    </div>
</div>

@if (sheet == null)
{
    <div class="nh-skeleton nh-card"></div>
}
else
{
    decimal ep = sheet.ElectricityPrice, wp = sheet.WaterPerPerson;
    var rows = sheet.Rows.Where(r => showAll || !r.SkipThisMonth).OrderBy(r => r.BlockCode).ThenBy(r => r.Floor).ThenBy(r => r.Number).ToList();
    var pending = rows.Where(r => !r.IsPaid(ep, wp)).ToList();
    var done = rows.Where(r => r.IsPaid(ep, wp)).ToList();
    decimal total = rows.Where(r => r.BillId != null).Sum(r => r.Total(ep, wp));
    decimal paid = rows.Sum(r => r.Paid);
    int needed = rows.Count(r => !r.SkipThisMonth), noMeter = rows.Count(r => r.BillId == null && !r.SkipThisMonth);

    <div class="nh-stats">
        <div class="nh-stat accent-blue"><div class="v">@done.Count<span class="of">/@needed</span></div><div class="l">Phòng đã thu</div></div>
        <div class="nh-stat"><div class="v">@Fmt.Money(total)</div><div class="l">Tổng phải thu</div></div>
        <div class="nh-stat accent-green"><div class="v">@Fmt.Money(paid)</div><div class="l">Đã thu</div></div>
        <div class="nh-stat accent-red"><div class="v">@Fmt.Money(Math.Max(0, total - paid))</div><div class="l">Còn lại</div></div>
    </div>

    <div class="nh-toolbar">
        <div class="hint">
            <i class="fas fa-bolt"></i> Kỳ chốt <strong>@Fmt.Date(sheet.DueDate)</strong> · điện @Fmt.Money(ep)đ/số · nước @Fmt.Money(wp)đ/người.
            @if (noMeter > 0) { <span>Còn <a href="so-dien" class="fw-bold">@noMeter phòng chưa ghi số điện</a>.</span> }
        </div>
        <label class="nh-switch">
            <input type="checkbox" @bind="showAll" /><span></span>
            <small>Hiện cả phòng mới vào tháng này</small>
        </label>
    </div>

    <div class="nh-gwrap">
        <div class="nh-gtable bill">
            <div class="gr gh">
                <div>Phòng</div><div>Người thuê</div><div class="n">Số điện</div><div class="n">Tiền phòng</div><div class="n">Điện</div><div class="n">Nước</div>
                <div class="n">Tổng</div><div class="n">Đã thu</div><div>Tình trạng</div><div></div>
            </div>
            @if (rows.Count == 0)
            {
                <div class="gr sec"><div class="text-center text-muted py-3">Không có phòng nào cần thu tiền tháng này.</div></div>
            }
            @if (pending.Count > 0)
            {
                <div class="gr sec"><div><span class="dot red"></span> Chưa thu · @pending.Count phòng</div></div>
                @foreach (var r in pending) { @Row(r, ep, wp) }
            }
            @if (done.Count > 0)
            {
                <div class="gr sec"><div><span class="dot green"></span> Đã thu · @done.Count phòng</div></div>
                @foreach (var r in done) { @Row(r, ep, wp) }
            }
        </div>
    </div>

    @if (edit != null)
    {
        <div class="nh-modal-backdrop" @onclick="CancelEditAsync">
            <div class="nh-modal" style="max-width: 460px" @onclick:stopPropagation="true">
                <div class="nh-modal-header"><h5><i class="fas fa-pen"></i> Sửa phiếu phòng @edit.RoomCode</h5><button type="button" class="btn-close btn-close-white" @onclick="CancelEditAsync"></button></div>
                <div class="nh-modal-body">
                    <div class="small text-muted mb-2"><i class="fas fa-calculator"></i> Tiền phòng: @edit.RentDetail · điện @Fmt.Money(ep)đ/số · nước @Fmt.Money(wp)đ/người</div>
                    <div class="nh-form-grid">
                        <label class="nh-field"><span>Tiền phòng kỳ này</span><MoneyInput @bind-Value="edit.Rent" /></label>
                        <label class="nh-field"><span>Số người</span><input type="number" min="0" class="form-control" @bind="edit.PersonCount" /></label>
                        <label class="nh-field"><span>Số điện (kWh)</span><input type="number" min="0" class="form-control" @bind="edit.Kwh" /></label>
                        <label class="nh-field wide"><span>Ghi chú</span><input class="form-control" maxlength="200" @bind="edit.Note" /></label>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <strong>Tổng: @Fmt.Vnd(edit.Total(ep, wp))</strong>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CancelEditAsync">Hủy</button>
                            <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="SaveEditAsync"><i class="fas fa-save"></i> Lưu phiếu</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <PaymentDialog Bill="payBill" Paid="payPaid" RoomCode="@payRoom" Closed="() => payBill = null" Saved="AfterPayAsync" />
}

@code {
    private int month, year;
    private BillingSheet? sheet;
    private bool showAll;
    private Bill? payBill;
    private decimal payPaid;
    private string payRoom = "";
    private BillingRow? edit;

    /// <summary>Một dòng của bảng. Các dòng dùng chung cột của bảng (CSS subgrid) nên luôn thẳng hàng.</summary>
    private RenderFragment Row(BillingRow r, decimal ep, decimal wp) => __builder =>
    {
        var t = r.Total(ep, wp);
        bool isDone = r.IsPaid(ep, wp);
        string state = isDone ? "done" : r.BillId != null ? "unpaid" : r.SkipThisMonth ? "skip" : "new";
        <div class="gr @state" @key="r.LeaseId">
            <div class="c-room"><a href="@($"phong/{r.RoomCode}")" class="room">@r.RoomCode</a></div>
            <div class="c-name">
                <div class="name">@r.Representative@if (r.Company != null) { <span class="badge bg-info-subtle text-info-emphasis ms-1">HĐ @r.Company</span> }</div>
                <div class="sub" title="@r.RentDetail">@r.RentDetail
                    @if (r.PreviousDebt > 0) { <span class="debt"> · nợ cũ @Fmt.Money(r.PreviousDebt)</span> }</div>
            </div>
            <div class="c-info">
                <div class="c-kwh n" data-l="Số điện">@(r.Kwh is int k ? k.ToString() : "-")</div>
                <div class="c-rent n" data-l="Phòng">@Fmt.Money(r.Rent)</div>
                <div class="c-el n" data-l="Điện">@Fmt.Money(r.Electricity(ep))@if (r.Kwh is int kw) { <div class="sub">@kw số × @Fmt.Money(ep)</div> }</div>
                <div class="c-wa n" data-l="Nước">@Fmt.Money(r.Water(wp))<div class="sub">@(r.WaterFixed != null ? "cố định/phòng" : $"{r.PersonCount} người × {Fmt.Money(wp)}")</div></div>
            </div>
            <div class="c-total n">@(r.BillId != null || r.SkipThisMonth ? Fmt.Money(t) : "-")</div>
            <div class="c-paid n" data-l="Đã thu">@Fmt.Money(r.Paid)</div>
            <div class="c-state">
                @if (isDone) { <span class="pill pill-done"><i class="fas fa-check"></i> Đã thu</span> }
                else if (r.BillId != null) { <span class="pill pill-unpaid">Chưa thu@(r.Paid > 0 ? $" · còn {Fmt.Money(t - r.Paid)}" : "")</span> }
                else if (r.SkipThisMonth) { <span class="pill pill-skip">Không cần</span> }
                else { <span class="pill pill-new">Chưa ghi số điện</span> }
            </div>
            <div class="c-act">
                @if (r.BillId == null && !r.SkipThisMonth)
                {
                    <a class="btn btn-sm btn-warning" href="so-dien"><i class="fas fa-bolt"></i> Ghi số điện</a>
                }
                @if (r.BillId != null && !isDone)
                {
                    <button type="button" class="btn btn-sm btn-success" @onclick="() => OpenPayAsync(r)"><i class="fas fa-hand-holding-dollar"></i> Thu tiền</button>
                    <button type="button" class="btn btn-sm btn-light" title="Sửa phiếu" @onclick="() => edit = r"><i class="fas fa-pen"></i></button>
                }
                @if (r.BillId != null)
                {
                    <a class="btn btn-sm btn-light" title="In phiếu thu" href="@($"files/bills/{r.BillId}")" target="_blank"><i class="fas fa-print"></i></a>
                }
            </div>
        </div>
    };

    protected override async Task OnInitializedAsync()
    {
        var s = await Setup.GetSettingsAsync();
        (month, year) = RoomService.CurrentBillingPeriod(s.BillingDay);
        await LoadAsync();
    }

    private async Task LoadAsync() => sheet = await Billing.GetSheetAsync(month, year);

    private async Task ShiftAsync(int delta)
    {
        var d = new DateTime(year, month, 1).AddMonths(delta);
        (month, year) = (d.Month, d.Year);
        sheet = null;
        await LoadAsync();
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParseExact(e.Value?.ToString(), "yyyy-MM", null, System.Globalization.DateTimeStyles.None, out var d))
        {
            (month, year) = (d.Month, d.Year);
            sheet = null;
            await LoadAsync();
        }
    }

    private async Task SaveEditAsync()
    {
        if (edit == null) return;
        var user = await GetUserNameAsync();
        var r = edit;
        if (await RunAsync(async () => r.BillId = await Billing.SaveBillAsync(month, year, r, user), $"Đã lưu phiếu phòng {r.RoomCode}."))
        {
            edit = null;
            await LoadAsync();
        }
    }

    /// <summary>Hủy sửa: tải lại để bỏ các số vừa gõ.</summary>
    private async Task CancelEditAsync()
    {
        edit = null;
        await LoadAsync();
    }

    private async Task OpenPayAsync(BillingRow r)
    {
        payBill = await Billing.GetBillAsync(r.BillId!.Value);
        payPaid = r.Paid;
        payRoom = r.RoomCode;
    }

    private async Task AfterPayAsync()
    {
        payBill = null;
        await LoadAsync();
    }
}
