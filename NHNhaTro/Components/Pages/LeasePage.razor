@page "/hop-dong/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits NhPage
@inject LeaseService Leases
@inject SetupService Setup
@inject BillingService Billing
@inject AccountService Accounts

<PageTitle>Hợp đồng phòng @lease?.Room.Code</PageTitle>

@if (lease == null)
{
    <div class="nh-loading">@(notFound ? "Không tìm thấy hợp đồng." : "Đang tải...")</div>
}
else
{
    bool active = lease.Status == LeaseStatus.Active;
    var people = lease.Tenants.Where(t => t.MoveOutDate == null).OrderByDescending(t => t.IsRepresentative).ToList();
    var gone = lease.Tenants.Where(t => t.MoveOutDate != null).OrderByDescending(t => t.MoveOutDate).ToList();
    var debt = lease.Bills.Sum(b => Math.Max(0, b.TotalAmount - b.Payments.Sum(p => p.Amount)));
    var missingCards = people.Count(t => t.Tenant.IdentityCard.StartsWith("CHUA-CO", StringComparison.OrdinalIgnoreCase));
    var st = !active ? "st-ended" : debt > 0 ? "st-debt" : "";

    <div class="nh-hero-room @st">
        <div class="top">
            <div class="min-w-0">
                <div class="code">Phòng @lease.Room.Code</div>
                <div class="sub"><i class="fas fa-user"></i> @(people.FirstOrDefault()?.Tenant.FullName ?? "—") · @people.Count người · @Fmt.Date(lease.StartDate)@(active ? "" : " → " + Fmt.Date(lease.EndDate))</div>
            </div>
            <div class="tags">
                <span class="tag">@(active ? "Đang thuê" : "Đã trả phòng")</span>
                @if (lease.IsExistingTenant) { <span class="tag" title="Khách đang ở trước khi dùng phần mềm, nhập ban đầu">Khách cũ</span> }
                @if (missingCards > 0) { <span class="tag warn"><i class="fas fa-id-card"></i> @missingCards người chưa có CCCD</span> }
            </div>
        </div>
        <div class="nh-hero-stats">
            <div><div class="l">Giá thuê</div><div class="v">@Fmt.Money(lease.MonthlyRent)</div></div>
            <div><div class="l">Cọc đang giữ</div><div class="v">@Fmt.Money(depositHeld)</div></div>
            <div><div class="l">Còn nợ</div><div class="v">@Fmt.Money(debt)</div></div>
        </div>
    </div>

    <div class="nh-quick">
        <a class="q-slate" href="@($"phong/{lease.Room.Code}")"><i class="fas fa-door-closed"></i>Phòng @lease.Room.Code</a>
        <a class="q-violet" href="@($"files/contracts/{lease.Id}")" target="_blank"><i class="fas fa-print"></i>In hợp đồng</a>
        @if (active)
        {
            <button type="button" class="q-blue" @onclick="() => editPeople = !editPeople"><i class="fas fa-user-edit"></i>Sửa người ở</button>
            <a class="q-red" href="@($"tra-phong/{lease.Id}")"><i class="fas fa-sign-out-alt"></i>Trả phòng</a>
        }
        else
        {
            <a class="q-red" href="@($"files/checkout/{lease.Id}")" target="_blank"><i class="fas fa-file-pdf"></i>Biên bản trả phòng</a>
        }
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="nh-sec t-blue">
                <div class="nh-sec-h">
                    <span class="ic"><i class="fas fa-users"></i></span>
                    <h5>Người ở <small>@people.Count người đang ở@(gone.Count > 0 ? $" · {gone.Count} đã chuyển đi" : "")</small></h5>
                    @if (active)
                    {
                        <button type="button" class="btn btn-sm @(editPeople ? "btn-secondary" : "btn-outline-primary")" @onclick="() => editPeople = !editPeople">
                            <i class="fas @(editPeople ? "fa-times" : "fa-pen")"></i> @(editPeople ? "Đóng" : "Sửa")
                        </button>
                    }
                </div>
                @if (!editPeople)
                {
                    <div class="nh-sec-b">
                        <div class="nh-people">
                            @foreach (var t in people) { <PersonCard Link="t" /> }
                            @foreach (var t in gone) { <PersonCard Link="t" /> }
                        </div>
                        @if (missingCards > 0 && active)
                        {
                            <div class="small mt-2 text-warning-emphasis"><i class="fas fa-info-circle"></i> Bấm <strong>Sửa</strong> để chụp CCCD, quét và nhập số CCCD, điện thoại cho từng người.</div>
                        }
                    </div>
                }
                else
                {
                    <div class="nh-sec-edit">
                        <TenantEditor Tenants="tenants" MaxPeople="lease.Room.MaxOccupants" ExceptLeaseId="lease.Id" />
                        <div class="d-flex flex-wrap gap-2 align-items-end mt-3">
                            <div><label class="form-label">Ngày thay đổi (vào/ra)</label><input type="date" class="form-control" @bind="changeDate" /></div>
                            <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="SaveTenantsAsync"><i class="fas fa-save"></i> Lưu danh sách người ở</button>
                        </div>
                        <div class="small text-muted mt-1">Bỏ một người khỏi danh sách sẽ ghi ngày chuyển đi; tiền nước các kỳ sau tính theo số người còn ở.</div>
                    </div>
                }
            </div>

            <div class="nh-sec t-green">
                <div class="nh-sec-h">
                    <span class="ic"><i class="fas fa-receipt"></i></span>
                    <h5>Phiếu thu và các lần thu tiền <small>@lease.Bills.Count phiếu · còn nợ @Fmt.Vnd(debt)</small></h5>
                </div>
                <div class="nh-sec-b">
                    @if (lease.Bills.Count == 0)
                    {
                        <div class="nh-empty-hint"><i class="fas fa-receipt"></i>Chưa có phiếu thu.@(lease.IsExistingTenant ? " Khách cũ: kỳ thu đầu trên phần mềm là kỳ chốt tới." : "")</div>
                    }
                    <div class="nh-bills">
                        @foreach (var b in lease.Bills.OrderByDescending(b => b.Year).ThenByDescending(b => b.Month).ThenByDescending(b => b.Id))
                        {
                            var paid = b.Payments.Sum(p => p.Amount);
                            var canDelete = isAdmin && b.Kind == BillKind.Monthly && b.Payments.Count == 0;
                            <BillCard Bill="b" Paid="paid" RentDetail="@RentDetail(b)" ShowNote="true"
                                      OnPay="() => { payBill = b; payPaid = paid; }"
                                      OnDelete="@(canDelete ? EventCallback.Factory.Create(this, () => DeleteBillAsync(b)) : default)">
                                @foreach (var p in b.Payments.OrderBy(p => p.Date))
                                {
                                    <div class="pay">
                                        <span><i class="fas fa-check-circle text-success"></i> @Fmt.Date(p.Date): <strong>@Fmt.Vnd(p.Amount)</strong></span>
                                        <span class="text-muted">@p.Description · @p.CreatedBy</span>
                                        <AttachmentList EntityType="@AttachmentOwner.Transaction" EntityId="p.Id" ShowEmpty="false" CanDelete="isAdmin" />
                                        @if (isAdmin) { <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-auto" @onclick="() => DeletePaymentAsync(p)">Xóa khoản thu</button> }
                                    </div>
                                }
                            </BillCard>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="nh-sec t-violet">
                <div class="nh-sec-h">
                    <span class="ic"><i class="fas fa-file-contract"></i></span>
                    <h5>Hợp đồng</h5>
                    @if (active)
                    {
                        <button type="button" class="btn btn-sm @(editTerms ? "btn-secondary" : "btn-outline-secondary")" @onclick="() => editTerms = !editTerms">
                            <i class="fas @(editTerms ? "fa-times" : "fa-pen")"></i> @(editTerms ? "Đóng" : "Sửa")
                        </button>
                    }
                </div>
                <div class="nh-sec-b">
                    <div class="nh-kv">
                        <div><div class="l">Ngày vào</div><div class="v">@Fmt.Date(lease.StartDate)</div></div>
                        @if (!active) { <div><div class="l">Ngày trả</div><div class="v">@Fmt.Date(lease.EndDate)</div></div> }
                        <div><div class="l">Giá thuê/tháng</div><div class="v">@Fmt.Vnd(lease.MonthlyRent)</div></div>
                        <div><div class="l">Cọc theo hợp đồng</div><div class="v">@Fmt.Vnd(lease.Deposit)</div></div>
                    </div>
                    @if (!string.IsNullOrEmpty(lease.Note)) { <div class="small mt-2 text-muted"><i class="fas fa-sticky-note"></i> @lease.Note</div> }
                    <div class="mt-3">
                        <div class="small fw-bold mb-1"><i class="fas fa-file-signature text-secondary"></i> Hợp đồng đã ký (scan)</div>
                        <AttachmentList EntityType="@AttachmentOwner.Lease" EntityId="lease.Id" Kind="@AttachmentKind.ContractScan" CanDelete="isAdmin" Version="version" />
                        <div class="mt-2"><FileUpload Kind="Contracts" ButtonText="Tải bản scan" Files="scanFiles" Uploaded="OnScanUploadedAsync" /></div>
                    </div>
                </div>
                @if (editTerms && active)
                {
                    <div class="nh-sec-edit">
                        <div class="row g-2">
                            <div class="col-6"><label class="form-label">Giá thuê</label><MoneyInput @bind-Value="rent" /></div>
                            <div class="col-6"><label class="form-label">Tiền cọc</label><MoneyInput @bind-Value="deposit" disabled="@(!isAdmin)" /></div>
                            <div class="col-12"><label class="form-label">Ghi chú</label><textarea class="form-control" rows="2" @bind="note"></textarea></div>
                        </div>
                        <button type="button" class="btn btn-primary w-100 mt-2" disabled="@Busy" @onclick="SaveTermsAsync"><i class="fas fa-save"></i> Lưu hợp đồng</button>
                    </div>
                }
            </div>

            <div class="nh-sec t-amber">
                <div class="nh-sec-h">
                    <span class="ic"><i class="fas fa-piggy-bank"></i></span>
                    <h5>Tiền cọc <small>tài khoản cá nhân · đang giữ @Fmt.Vnd(depositHeld)</small></h5>
                </div>
                <div class="nh-sec-b @(deposits.Count > 0 ? "p0" : "")">
                    @foreach (var t in deposits)
                    {
                        <div class="nh-list-row">
                            <div class="main"><div class="t">@t.Description</div><div class="s">@Fmt.Date(t.Date)</div></div>
                            <AttachmentList EntityType="@AttachmentOwner.Transaction" EntityId="t.Id" ShowEmpty="false" />
                            <div class="amt @(t.Amount > 0 ? "text-success" : "text-danger")">@(t.Amount > 0 ? "+" : "")@Fmt.Money(t.Amount)</div>
                        </div>
                    }
                    @if (deposits.Count == 0) { <div class="text-muted small">Chưa ghi khoản cọc nào.</div> }
                </div>
                @if (active && depositHeld < lease.Deposit)
                {
                    <div class="nh-sec-edit">
                        <div class="small mb-2">Cọc theo hợp đồng @Fmt.Vnd(lease.Deposit), mới thu <strong class="text-danger">@Fmt.Vnd(depositHeld)</strong>.</div>
                        <div class="row g-2 align-items-end">
                            <div class="col-6"><label class="form-label">Thu thêm cọc</label><MoneyInput @bind-Value="depositAmount" /></div>
                            <div class="col-6"><label class="form-label">Ngày</label><input type="date" class="form-control" @bind="depositDate" /></div>
                        </div>
                        <div class="mt-2"><FileUpload Kind="Receipts" ButtonText="Chứng từ" @bind-Files="depositFiles" Scanned="r => { if (r.Amount is decimal a) depositAmount = a; if (r.Date is DateTime d) depositDate = d; }" /></div>
                        <button type="button" class="btn btn-warning w-100 mt-2 fw-bold" disabled="@Busy" @onclick="CollectDepositAsync"><i class="fas fa-hand-holding-usd"></i> Thu cọc</button>
                    </div>
                }
            </div>

            @if (!active)
            {
                <div class="nh-sec t-rose">
                    <div class="nh-sec-h">
                        <span class="ic"><i class="fas fa-clipboard-check"></i></span>
                        <h5>Trả phòng <small>@Fmt.Date(lease.EndDate)</small></h5>
                    </div>
                    <div class="nh-sec-b">
                        <div class="nh-kv">
                            <div><div class="l">Tiền cọc</div><div class="v">@Fmt.Money(lease.Deposit)</div></div>
                            <div><div class="l">Điện kỳ cuối</div><div class="v">@Fmt.Money(lease.CheckoutElectricity ?? 0)</div></div>
                            @foreach (var p in lease.Penalties) { <div><div class="l">Phạt: @p.Description</div><div class="v">@Fmt.Money(p.Amount)</div></div> }
                            @if ((lease.CheckoutOther ?? 0) != 0) { <div><div class="l">Khoản khác</div><div class="v">@Fmt.Money(lease.CheckoutOther ?? 0)</div></div> }
                            <div><div class="l">Đã trả cọc</div><div class="v text-success">@Fmt.Money(lease.DepositRefunded ?? 0)</div></div>
                            <div><div class="l">Khách nộp thêm</div><div class="v text-danger">@Fmt.Money(lease.CheckoutCollected ?? 0)</div></div>
                        </div>
                        @if (!string.IsNullOrEmpty(lease.FurnitureWarnings)) { <div class="small text-danger mt-2"><i class="fas fa-exclamation-triangle"></i> @lease.FurnitureWarnings</div> }
                        @if (!string.IsNullOrEmpty(lease.CheckoutNote)) { <p class="small mt-2 mb-2">@lease.CheckoutNote</p> }
                        <AttachmentList EntityType="@AttachmentOwner.Lease" EntityId="lease.Id" Kind="@AttachmentKind.CheckoutPhoto" />
                    </div>
                </div>
            }
        </div>
    </div>

    <PaymentDialog Bill="payBill" Paid="payPaid" RoomCode="@lease.Room.Code" Closed="() => payBill = null" Saved="AfterChangeAsync" />
}

@code {
    [Parameter] public int Id { get; set; }
    private Lease? lease;
    private int billingDay = 10;
    private string RentDetail(Bill b) => lease == null ? "" : LeaseService.RentDetail(b, lease, billingDay);
    private bool notFound, isAdmin, editPeople, editTerms;
    private decimal rent, deposit;
    private string? note;
    private List<TenantInput> tenants = [];
    private DateTime changeDate = DateTime.Today;
    private List<PendingFile> scanFiles = [];
    private int version;
    private Bill? payBill;
    private decimal payPaid;
    private List<LedgerRow> deposits = [];
    private decimal depositHeld, depositAmount;
    private DateTime depositDate = DateTime.Today;
    private List<PendingFile> depositFiles = [];

    protected override async Task OnParametersSetAsync()
    {
        isAdmin = await IsAdminAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        lease = await Leases.GetLeaseAsync(Id);
        billingDay = (await Setup.GetSettingsAsync()).BillingDay;
        notFound = lease == null;
        if (lease == null) return;
        rent = lease.MonthlyRent;
        deposit = lease.Deposit;
        note = lease.Note;
        tenants = lease.Tenants.Where(t => t.MoveOutDate == null).OrderByDescending(t => t.IsRepresentative).Select(t => TenantInput.From(t.Tenant)).ToList();
        if (tenants.Count == 0) tenants.Add(new TenantInput());
        var page = await Accounts.GetLedgerAsync(new LedgerFilter { LeaseId = lease.Id, PageSize = 200 });
        deposits = page.Rows.Where(r => r.LeaseId == lease.Id && r.Category is TxCategory.Deposit or TxCategory.DepositRefund || (r.Category == TxCategory.Transfer && r.Amount < 0)).ToList();
        depositHeld = await Leases.GetDepositHeldAsync(lease.Id);
        depositAmount = Math.Max(0, lease.Deposit - depositHeld);
        version++;
    }

    private async Task CollectDepositAsync()
    {
        var user = await GetUserNameAsync();
        if (await RunAsync(() => Leases.CollectDepositAsync(Id, depositAmount, depositDate, depositFiles, user), "Đã thu cọc."))
        {
            depositFiles = [];
            await LoadAsync();
        }
    }

    private async Task SaveTermsAsync()
    {
        if (await RunAsync(() => Leases.UpdateLeaseTermsAsync(Id, rent, deposit, note), "Đã lưu.")) { editTerms = false; await LoadAsync(); }
    }

    private async Task SaveTenantsAsync()
    {
        if (await RunAsync(() => Leases.SaveTenantsAsync(Id, tenants, changeDate), "Đã lưu danh sách người ở.")) { editPeople = false; await LoadAsync(); }
    }

    private async Task OnScanUploadedAsync(PendingFile f)
    {
        var user = await GetUserNameAsync();
        if (await RunAsync(() => Leases.SetContractScanAsync(Id, f, user), "Đã lưu bản scan hợp đồng."))
        {
            scanFiles.Clear();
            await LoadAsync();
        }
    }

    private async Task DeleteBillAsync(Bill b)
    {
        if (!await ConfirmAsync($"Xóa phiếu tháng {b.Month:00}/{b.Year}?")) return;
        if (await RunAsync(() => Billing.DeleteBillAsync(b.Id), "Đã xóa phiếu.")) await LoadAsync();
    }

    private async Task DeletePaymentAsync(MoneyTransaction p)
    {
        if (!await ConfirmAsync($"Xóa khoản thu {Fmt.Vnd(p.Amount)} ngày {Fmt.Date(p.Date)}?")) return;
        if (await RunAsync(() => Accounts.DeleteAsync(p.Id), "Đã xóa khoản thu.")) await LoadAsync();
    }

    private async Task AfterChangeAsync()
    {
        payBill = null;
        await LoadAsync();
    }
}
