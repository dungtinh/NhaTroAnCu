@inherits LayoutComponentBase
@inject SetupService Setup

@* Máy tính (≥ 992px): thanh menu trên. Điện thoại: thanh trên gọn + thanh điều hướng dưới + bảng "Thêm". *@
<nav class="navbar navbar-dark nh-navbar">
    <div class="container-fluid px-3 px-lg-4">
        <a class="navbar-brand fw-bold text-truncate" href=""><i class="fas fa-building"></i> @(settings?.Name ?? "Nhà trọ")</a>
        <AuthorizeView>
            <Authorized>
                <ul class="navbar-nav flex-row gap-1 me-auto d-none d-lg-flex">
                    @foreach (var m in Menu)
                    {
                        <li class="nav-item"><NavLink class="nav-link" href="@m.Href" Match="@(m.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)"><i class="fas @m.Icon"></i> @m.Text</NavLink></li>
                    }
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="fas fa-info-circle"></i> Thông tin</a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @foreach (var m in Info.Where(m => !m.AdminOnly || context.User.IsInRole(Roles.Admin)))
                            {
                                <li><a class="dropdown-item" href="@m.Href"><i class="fas @m.Icon fa-fw"></i> @m.Text</a></li>
                            }
                        </ul>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-1">
                    <ChatBadge @rendermode="InteractiveServer" />
                    <NavLink class="nav-link nh-user d-none d-lg-inline-flex" href="Account/Manage" title="@(context.User.IsInRole(Roles.Admin) ? "Quản trị" : "Nhân viên")">
                        <i class="fas fa-user-circle"></i> <span class="d-none d-xl-inline ms-1">@context.User.Identity?.Name</span>
                    </NavLink>
                    <form action="Account/Logout" method="post" class="d-none d-lg-inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="" />
                        <button type="submit" class="nav-link btn btn-link" title="Đăng xuất"><i class="fas fa-sign-out-alt"></i></button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="d-flex gap-1">
                    <NavLink class="nav-link" href="gioi-thieu"><i class="fas fa-home"></i><span class="d-none d-sm-inline"> Giới thiệu</span></NavLink>
                    <NavLink class="nav-link" href="Account/Login"><i class="fas fa-sign-in-alt"></i> Đăng nhập</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

<main class="container-fluid px-3 px-lg-4 nh-main">
    @Body
</main>

<footer class="nh-footer d-none d-lg-block">
    <div class="container-fluid px-lg-4">
        <strong>@(settings?.Name)</strong>
        @if (!string.IsNullOrWhiteSpace(settings?.Address)) { <span> · <i class="fas fa-map-marker-alt"></i> @settings.Address</span> }
        @if (!string.IsNullOrWhiteSpace(settings?.Phone)) { <span> · <i class="fas fa-phone"></i> @settings.Phone</span> }
    </div>
</footer>

<AuthorizeView>
    <Authorized>
        <nav class="nh-bottomnav d-lg-none" aria-label="Điều hướng chính">
            <NavLink href="" Match="NavLinkMatch.All"><i class="fas fa-home"></i><span>Trang chính</span></NavLink>
            <NavLink href="thu-tien"><i class="fas fa-file-invoice-dollar"></i><span>Thu tiền</span></NavLink>
            <NavLink href="nhan-phong" class="nh-fab" title="Nhận phòng"><i class="fas fa-door-open"></i><span>Nhận phòng</span></NavLink>
            <NavLink href="tra-phong"><i class="fas fa-sign-out-alt"></i><span>Trả phòng</span></NavLink>
            <button type="button" data-bs-toggle="offcanvas" data-bs-target="#nhMore" aria-controls="nhMore"><i class="fas fa-info-circle"></i><span>Thông tin</span></button>
        </nav>

        <div class="offcanvas offcanvas-bottom nh-more d-lg-none" tabindex="-1" id="nhMore" aria-labelledby="nhMoreTitle">
            <div class="offcanvas-header pb-1">
                <h6 class="offcanvas-title fw-bold" id="nhMoreTitle"><i class="fas fa-user-circle"></i> @context.User.Identity?.Name
                    <small class="text-muted fw-normal">(@(context.User.IsInRole(Roles.Admin) ? "Quản trị" : "Nhân viên"))</small></h6>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
            </div>
            <div class="offcanvas-body pt-2">
                <div class="small text-muted fw-bold mb-1">Nghiệp vụ</div>
                <div class="nh-more-grid mb-3">
                    @foreach (var m in Menu.Skip(1)) { <a href="@m.Href"><i class="fas @m.Icon"></i><span>@m.Text</span></a> }
                </div>
                <div class="small text-muted fw-bold mb-1">Thông tin</div>
                <div class="nh-more-grid">
                    @foreach (var m in Info.Where(m => !m.AdminOnly || context.User.IsInRole(Roles.Admin))) { <a href="@m.Href"><i class="fas @m.Icon"></i><span>@m.Text</span></a> }
                    <a href="Account/Manage"><i class="fas fa-user-cog"></i><span>Tài khoản</span></a>
                </div>
                <form action="Account/Logout" method="post" class="mt-3">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="" />
                    <button type="submit" class="btn btn-outline-danger w-100"><i class="fas fa-sign-out-alt"></i> Đăng xuất</button>
                </form>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

<Toasts @rendermode="InteractiveServer" />

<div id="blazor-error-ui" data-nosnippet>
    Đã có lỗi xảy ra.
    <a href="." class="reload">Tải lại trang</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private record MenuItem(string Href, string Icon, string Text, bool AdminOnly = false);

    // 5 nghiệp vụ chính (theo yêu cầu: tối giản cho người dùng)
    private static readonly MenuItem[] Menu =
    [
        new("", "fa-home", "Trang chính"),
        new("nhan-phong", "fa-door-open", "Nhận phòng"),
        new("tra-phong", "fa-sign-out-alt", "Trả phòng"),
        new("thu-tien", "fa-file-invoice-dollar", "Thu tiền tháng"),
        new("sua-chua", "fa-tools", "Sửa chữa"),
        new("mua-sam", "fa-shopping-cart", "Mua sắm"),
    ];

    // Phần còn lại gom vào "Thông tin"
    private static readonly MenuItem[] Info =
    [
        new("chat", "fa-comments", "Chat nội bộ"),
        new("so-do", "fa-th-large", "Sơ đồ phòng"),
        new("khach-thue", "fa-users", "Khách thuê"),
        new("thu-chi", "fa-wallet", "Thu chi"),
        new("bao-cao", "fa-chart-bar", "Báo cáo"),
        new("quang-cao", "fa-bullhorn", "Quảng cáo"),
        new("cau-hinh", "fa-cog", "Cấu hình", AdminOnly: true),
        new("huong-dan", "fa-question-circle", "Hướng dẫn"),
        new("gioi-thieu", "fa-globe-asia", "Trang khách xem"),
        new("app", "fa-mobile-alt", "Cài ứng dụng"),
    ];

    private AppSetting? settings;

    protected override async Task OnInitializedAsync()
    {
        try { settings = await Setup.GetSettingsAsync(); }
        catch (InvalidOperationException) { }
    }
}
