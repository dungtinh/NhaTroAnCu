@inherits LayoutComponentBase
@inject SetupService Setup

<nav class="navbar navbar-expand-lg navbar-dark nh-navbar">
    <div class="container-fluid px-lg-4">
        <a class="navbar-brand fw-bold" href=""><i class="fas fa-building"></i> @(settings?.Name ?? "Nhà trọ")</a>
        <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <AuthorizeView>
                <Authorized>
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><NavLink class="nav-link" href="" Match="NavLinkMatch.All"><i class="fas fa-th"></i> Sơ đồ phòng</NavLink></li>
                        <li class="nav-item"><NavLink class="nav-link" href="thu-tien"><i class="fas fa-file-invoice-dollar"></i> Thu tiền</NavLink></li>
                        <li class="nav-item"><NavLink class="nav-link" href="khach-thue"><i class="fas fa-users"></i> Khách thuê</NavLink></li>
                        <li class="nav-item"><NavLink class="nav-link" href="sua-chua"><i class="fas fa-tools"></i> Sửa chữa</NavLink></li>
                        <li class="nav-item"><NavLink class="nav-link" href="mua-sam"><i class="fas fa-shopping-cart"></i> Mua sắm</NavLink></li>
                        <li class="nav-item"><NavLink class="nav-link" href="thu-chi"><i class="fas fa-wallet"></i> Thu chi</NavLink></li>
                        <li class="nav-item"><NavLink class="nav-link" href="quang-cao"><i class="fas fa-bullhorn"></i> Quảng cáo</NavLink></li>
                        @if (context.User.IsInRole(Roles.Admin))
                        {
                            <li class="nav-item"><NavLink class="nav-link" href="cau-hinh"><i class="fas fa-cog"></i> Cấu hình</NavLink></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <NavLink class="nav-link" href="Account/Manage" title="@(context.User.IsInRole(Roles.Admin) ? "Quản trị" : "Nhân viên")">
                                <i class="fas fa-user-circle"></i> @context.User.Identity?.Name
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <form action="Account/Logout" method="post" class="d-inline">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="" />
                                <button type="submit" class="nav-link btn btn-link"><i class="fas fa-sign-out-alt"></i> Thoát</button>
                            </form>
                        </li>
                    </ul>
                </Authorized>
                <NotAuthorized>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><NavLink class="nav-link" href="gioi-thieu"><i class="fas fa-home"></i> Giới thiệu</NavLink></li>
                        <li class="nav-item"><NavLink class="nav-link" href="Account/Login"><i class="fas fa-sign-in-alt"></i> Đăng nhập</NavLink></li>
                    </ul>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

<main class="container-fluid px-lg-4 nh-main">
    @Body
</main>

<footer class="nh-footer">
    <div class="container-fluid px-lg-4">
        <strong>@(settings?.Name)</strong>
        @if (!string.IsNullOrWhiteSpace(settings?.Address)) { <span> · <i class="fas fa-map-marker-alt"></i> @settings.Address</span> }
        @if (!string.IsNullOrWhiteSpace(settings?.Phone)) { <span> · <i class="fas fa-phone"></i> @settings.Phone</span> }
    </div>
</footer>

<Toasts @rendermode="InteractiveServer" />

<div id="blazor-error-ui" data-nosnippet>
    Đã có lỗi xảy ra.
    <a href="." class="reload">Tải lại trang</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private AppSetting? settings;

    protected override async Task OnInitializedAsync()
    {
        try { settings = await Setup.GetSettingsAsync(); }
        catch (InvalidOperationException) { }
    }
}
