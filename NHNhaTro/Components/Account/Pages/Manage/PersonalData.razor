@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using NHNhaTro.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Dữ liệu cá nhân</PageTitle>

<StatusMessage />
<h3>Dữ liệu cá nhân</h3>

<div class="row">
    <div class="col-md-6">
        <p>Tài khoản của bạn chứa dữ liệu cá nhân bạn đã cung cấp. Tại đây bạn có thể tải về hoặc xóa dữ liệu đó.</p>
        <p>
            <strong>Xóa dữ liệu này sẽ xóa vĩnh viễn tài khoản của bạn và không thể khôi phục.</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">Tải về</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">Xóa</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
